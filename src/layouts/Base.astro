---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import { SITE_NAME, TAGLINE } from '../consts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = `${SITE_NAME} — ${TAGLINE}`,
  description = 'Qreturns gives Shopify merchants a self-service return portal on their own domain, return rules, prepaid labels through Shippo, and approval, inspection and refund inside Shopify.',
  noindex = false,
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://qreturns.com/#org',
      name: 'Qreturns',
      url: 'https://qreturns.com/',
      email: 'support@qreturns.com',
      description: 'Qreturns is a Shopify returns management app with a branded self-service customer portal.',
      areaServed: 'Worldwide',
    },
    {
      '@type': 'SoftwareApplication',
      '@id': 'https://qreturns.com/#app',
      name: 'Qreturns — Returns for Shopify',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Shopify',
      description: 'Manage returns, return rules, prepaid shipping labels and refunds on Shopify.',
      offers: [
        { '@type': 'Offer', name: 'Free', price: '0', priceCurrency: 'USD' },
        { '@type': 'Offer', name: 'Starter', price: '19', priceCurrency: 'USD' },
        { '@type': 'Offer', name: 'Growth', price: '49', priceCurrency: 'USD' },
        { '@type': 'Offer', name: 'Pro', price: '149', priceCurrency: 'USD' },
      ],
      publisher: { '@id': 'https://qreturns.com/#org' },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Qreturns" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  </head>
  <body class="min-h-screen flex flex-col justify-between bg-bg text-ink">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
    <StickyCta />
    <script src="/assets/app.js" is:inline defer></script>
  </body>
</html>
