---
import { NAV, APP_STORE_URL, DEMO_URL, SITE_NAME } from '../consts';
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header class="site">
  <div class="wrap nav">
    <a href="/" class="logo" aria-label={`${SITE_NAME} home`}>
      <svg class="logomark" viewBox="-30 110 352 320" aria-hidden="true"><path fill="#1E1E1A" fill-rule="evenodd" d="M77.97 140L216.54 140A75.37 75.37 0 0 1 291.91 215.37L291.91 285.61A43.09 43.09 0 0 0 265.59 276.63L220.16 276.63L220.15 233.17A28.76 28.76 0 0 0 191.4 204.42L97.4 204.42A25.64 25.64 0 0 0 71.76 230.05L71.76 311.73A25.25 25.25 0 0 0 97.01 336.98L153.14 336.98L153.14 373.67A43.09 43.09 0 0 0 162.12 400L74.33 400A74.33 74.33 0 0 1 0 325.67L0 217.97A77.97 77.97 0 0 1 77.97 140Z"/><path fill="#BE123C" d="M196.24 293.40H265.58A26.33 26.33 0 0 1 291.91 319.73V373.67A26.33 26.33 0 0 1 265.58 400.00H196.24A26.33 26.33 0 0 1 169.91 373.67V319.73A26.33 26.33 0 0 1 196.24 293.40Z"/><path fill="#F4F1EA" d="M212.42 322.18H254.28A10.79 10.79 0 0 1 265.07 332.97V360.43A10.79 10.79 0 0 1 254.28 371.22H212.42A10.79 10.79 0 0 1 201.63 360.43V332.97A10.79 10.79 0 0 1 212.42 322.18Z"/><circle cx="218.1" cy="335.9" r="4.9" fill="#BE123C"/><path fill="#BE123C" d="M247.3 355.5h-16.5v-6.9l-14.0 11.8l14.0 11.8v-6.9h16.5Z"/></svg>
      <span>{SITE_NAME}</span>
    </a>

    <nav class="nav-links" id="nav-links">
      {NAV.map(([href, label]) => (
        <a href={href} class={path === href ? 'active' : ''}>
          {label}
        </a>
      ))}
    </nav>

    <div class="nav-cta">
      <a href={DEMO_URL} class="btn btn-line btn-sm hidden sm:inline-flex">
        Portal Demo
      </a>
      <a href={APP_STORE_URL} class="btn btn-accent btn-sm">
        Install free
      </a>
      <button class="menu-btn" aria-label="Open menu" aria-controls="nav-links" aria-expanded="false">
        <svg class="ic-open" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg class="ic-close" viewBox="0 0 24 24"><path d="M6 6l12 12M6 18L18 6"/></svg>
      </button>
    </div>
  </div>
</header>
<div class="nav-overlay"></div>
