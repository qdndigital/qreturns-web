              isEligible: true,
            },
          ],
        },
        {
          id: 'ord_1005',
          orderNumber: '1005',
          email: 'expired@example.com',
          customerName: 'Morgan Lee',
          orderDate: 'May 10, 2026',
          deliveredDate: 'May 14, 2026',
          currency: 'USD',
          items: [
            {
              id: 'item_7',
              name: 'Heavyweight Fleece Pullover',
              variant: 'Black / M',
              price: 88.0,
              quantity: 1,
              image: "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 80 80' fill='none'%3E%3Crect width='80' height='80' rx='12' fill='%23f1f3f5'/%3E%3Cpath d='M24 28L32 20H48L56 28L52 36L44 32V60H36V32L28 36L24 28Z' fill='%23343a40'/%3E%3C/svg%3E",
              isEligible: false,
              ineligibleReason: 'Delivered over 30 days ago (return window has closed)',
            },
          ],
        },
      ];

      const found = mockOrders.find(
        (o) => o.orderNumber === cleanNum && o.email.toLowerCase() === emailRaw
      );

      if (!found) {
        const orderDifferentEmail = mockOrders.find((o) => o.orderNumber === cleanNum);
        if (orderDifferentEmail) {
          showError(
            'Email mismatch',
            'Order #' + cleanNum + ' was found, but the email address does not match our records.'
          );
        } else {
          showError(
            'Order not found',
            'No order found matching #' + cleanNum + ' and ' + emailRaw + '. Please verify your receipt.'
          );
        }
        return;
      }

      // Check if all items are ineligible
      const eligibleItems = found.items.filter((i) => i.isEligible);
      if (eligibleItems.length === 0) {
        showError(
          'Return window expired',
          'Items in this order are past the 30-day return window or marked as final sale.'
        );
        return;
      }

      state.order = found;
      state.selectedItems = {};
      goToStep(2);
    }

    if (elements.btnLookup) {
      elements.btnLookup.addEventListener('click', performLookup);
    }

    // Step 2: Render Items
    function renderOrderItems() {
      if (!state.order) return;

      elements.orderMetaNumber.textContent = 'Order #' + state.order.orderNumber;
      elements.orderMetaDetails.textContent = 'Delivered on ' + state.order.deliveredDate + ' to ' + state.order.customerName;

      let html = '';
      state.order.items.forEach((item) => {
        const isSelected = !!state.selectedItems[item.id];
        const selectedQty = state.selectedItems[item.id]?.quantity || 1;

        if (item.isEligible) {
          html += `
            <div class="p-4 rounded-xl border transition-all flex items-start gap-3.5 sm:gap-4 ${
              isSelected ? 'border-brand ring-2 ring-brand-soft bg-emerald-50/10' : 'border-line hover:border-line-2 bg-white'
            }" data-item-card="${item.id}">
              <input
                type="checkbox"
                class="item-checkbox accent-brand w-5 h-5 rounded mt-1 cursor-pointer shrink-0"
                data-item-id="${item.id}"
                ${isSelected ? 'checked' : ''}
              />
              <img src="${item.image}" alt="${item.name}" class="w-14 h-14 rounded-lg object-cover bg-bg-2 border border-line shrink-0" />
              <div class="flex-grow min-w-0">
                <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-1">
                  <div>
                    <h3 class="text-sm font-semibold text-ink leading-snug">${item.name}</h3>
                    <p class="text-xs text-muted mt-0.5">${item.variant}</p>
                  </div>
                  <span class="text-sm font-mono font-bold text-ink shrink-0">$${item.price.toFixed(2)}</span>
                </div>

                <div class="flex items-center justify-between mt-3 pt-2.5 border-t border-line/60">
                  <div class="flex items-center gap-2">
                    <span class="text-xs text-muted">Quantity:</span>
                    ${
                      item.quantity > 1
                        ? `
                        <select class="item-qty-select form-select py-1 px-2 text-xs w-20 h-7" data-item-id="${item.id}">
                          ${Array.from({ length: item.quantity }, (_, i) => i + 1)
                            .map((q) => `<option value="${q}" ${q === selectedQty ? 'selected' : ''}>${q}</option>`)
                            .join('')}
                        </select>
                      `
                        : `<span class="text-xs font-mono font-semibold text-ink">1</span>`
                    }
                  </div>
                  <span class="badge badge-brand text-[10px]">Eligible for return</span>
                </div>
              </div>
            </div>
          `;
