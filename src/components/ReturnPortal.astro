          html += `
            <div class="p-4 rounded-xl border border-line-2 bg-bg-2 opacity-75 flex items-start gap-3.5 sm:gap-4">
              <div class="w-5 h-5 rounded border border-line-2 bg-white/60 flex items-center justify-center text-muted mt-1 shrink-0">
                <svg class="w-3 h-3 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
              </div>
              <img src="${item.image}" alt="${item.name}" class="w-14 h-14 rounded-lg object-cover bg-bg-2 border border-line shrink-0 grayscale opacity-80" />
              <div class="flex-grow min-w-0">
                <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-1">
                  <div>
                    <h3 class="text-sm font-semibold text-ink-2 leading-snug">${item.name}</h3>
                    <p class="text-xs text-muted mt-0.5">${item.variant}</p>
                  </div>
                  <span class="text-sm font-mono text-muted shrink-0">$${item.price.toFixed(2)}</span>
                </div>
                <div class="mt-2.5 pt-2 border-t border-line flex items-center gap-1.5 text-xs text-amber-800">
                  <svg class="w-3.5 h-3.5 text-amber-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                  <span>${item.ineligibleReason || 'Ineligible for return'}</span>
                </div>
              </div>
            </div>
          `;
        }
      });

      elements.orderItemsList.innerHTML = html;
      bindItemSelectionEvents();
      updateItemsSelectionSummary();
    }

    function bindItemSelectionEvents() {
      document.querySelectorAll('.item-checkbox').forEach((checkbox) => {
        checkbox.addEventListener('change', function () {
          const itemId = this.getAttribute('data-item-id');
          const item = state.order.items.find((i) => i.id === itemId);
          if (this.checked) {
            const qtySelect = document.querySelector(`.item-qty-select[data-item-id="${itemId}"]`);
            const qty = qtySelect ? parseInt(qtySelect.value, 10) : 1;
            state.selectedItems[itemId] = {
              quantity: qty,
              reason: 'wrong_size',
              notes: '',
            };
          } else {
            delete state.selectedItems[itemId];
          }
          renderOrderItems();
        });
      });

      document.querySelectorAll('.item-qty-select').forEach((select) => {
        select.addEventListener('change', function () {
          const itemId = this.getAttribute('data-item-id');
          if (state.selectedItems[itemId]) {
            state.selectedItems[itemId].quantity = parseInt(this.value, 10);
            updateItemsSelectionSummary();
          }
        });
      });
    }

    function updateItemsSelectionSummary() {
      const selectedKeys = Object.keys(state.selectedItems);
      const totalSelected = selectedKeys.length;

      let totalValue = 0;
      selectedKeys.forEach((k) => {
        const item = state.order.items.find((i) => i.id === k);
        if (item) {
          totalValue += item.price * state.selectedItems[k].quantity;
        }
      });

      elements.itemsSelectedValue.textContent = '$' + totalValue.toFixed(2);

      if (totalSelected > 0) {
        elements.btnProceedReasons.removeAttribute('disabled');
      } else {
        elements.btnProceedReasons.setAttribute('disabled', 'true');
      }
    }

    // Step 2 Navigation
    document.getElementById('btn-change-order')?.addEventListener('click', () => goToStep(1));
    document.getElementById('btn-back-to-step-1')?.addEventListener('click', () => goToStep(1));
    elements.btnProceedReasons?.addEventListener('click', () => {
      if (Object.keys(state.selectedItems).length === 0) {
        showError('Select an item', 'Please choose at least one eligible item to return.');
        return;
      }
      goToStep(3);
    });

    // Step 3: Render Reasons
    function renderReasonStep() {
      let html = '';
      const selectedIds = Object.keys(state.selectedItems);

      selectedIds.forEach((id) => {
        const item = state.order.items.find((i) => i.id === id);
        const itemState = state.selectedItems[id];
        if (!item) return;

        html += `
          <div class="rounded-xl border border-line p-5 bg-white space-y-4" data-reason-box="${item.id}">
            <div class="flex items-center gap-3 pb-3 border-b border-line">
              <img src="${item.image}" alt="${item.name}" class="w-12 h-12 rounded-lg object-cover border border-line bg-bg-2 shrink-0" />
              <div>
                <h3 class="text-sm font-bold text-ink">${item.name}</h3>
                <p class="text-xs text-muted">Returning: ${itemState.quantity} unit(s) · ${item.variant}</p>
              </div>
            </div>

            <div>
              <label class="form-label">Return Reason</label>
              <select class="form-select item-reason-dropdown" data-item-id="${item.id}">
                ${REASONS.map(
                  (r) => `<option value="${r.code}" ${r.code === itemState.reason ? 'selected' : ''}>${r.label}</option>`
                ).join('')}
              </select>
            </div>

            <div class="reason-notes-container ${itemState.reason === 'other' || itemState.reason === 'damaged_item' || itemState.reason === 'defective_item' ? '' : 'hidden'}" data-notes-box="${item.id}">
              <label class="form-label">Additional Details / Explanation</label>
              <textarea
                class="form-textarea item-notes-input text-xs"
                rows="2"
                placeholder="Please describe the issue or fit in detail..."
                data-item-id="${item.id}"
              >${itemState.notes || ''}</textarea>
            </div>

            ${
              itemState.reason === 'damaged_item' || itemState.reason === 'defective_item'
                ? `
                <div class="p-3 rounded-lg bg-bg-2 border border-line-2 text-xs text-ink-2">
                  <span class="font-semibold block mb-1">Upload Photo (Optional for faster approval)</span>
                  <div class="flex items-center gap-2">
                    <label class="btn btn-line btn-sm cursor-pointer text-xs">
                      <span>Choose Image</span>
                      <input type="file" class="hidden" accept="image/*" />
                    </label>
                    <span class="text-muted text-[11px]">JPG, PNG under 10MB</span>
                  </div>
                </div>
              `
                : ''
            }
          </div>
        `;
      });

      elements.itemsReasonsContainer.innerHTML = html;

      // Event listeners for reason dropdowns
      document.querySelectorAll('.item-reason-dropdown').forEach((dropdown) => {
        dropdown.addEventListener('change', function () {
          const itemId = this.getAttribute('data-item-id');
          const reason = this.value;
          if (state.selectedItems[itemId]) {
            state.selectedItems[itemId].reason = reason;
          }
          renderReasonStep();
        });
      });

      document.querySelectorAll('.item-notes-input').forEach((textarea) => {
        textarea.addEventListener('input', function () {
          const itemId = this.getAttribute('data-item-id');
          if (state.selectedItems[itemId]) {
            state.selectedItems[itemId].notes = this.value;
          }
        });
      });
    }

    document.getElementById('btn-back-to-items')?.addEventListener('click', () => goToStep(2));
    document.getElementById('btn-proceed-to-method')?.addEventListener('click', () => goToStep(4));

    // Step 4: Method & Resolution Handlers
    function updateResolutionAndMethodUI() {
      // Bind resolution radios
      document.querySelectorAll('input[name="resolution_choice"]').forEach((r) => {
        r.addEventListener('change', function () {
          state.selectedResolution = this.value;
          document.querySelectorAll('.resolution-card').forEach((card) => {
            const isMatch = card.getAttribute('data-resolution-type') === state.selectedResolution;
            if (isMatch) {
              card.className = 'relative p-4 rounded-xl border cursor-pointer transition-all flex flex-col justify-between border-brand ring-2 ring-brand-soft bg-emerald-50/20 resolution-card';
            } else {
              card.className = 'relative p-4 rounded-xl border cursor-pointer transition-all flex flex-col justify-between border-line hover:border-line-2 bg-white resolution-card';
            }
          });
        });
      });

      // Bind method radios
      document.querySelectorAll('input[name="method_choice"]').forEach((r) => {
        r.addEventListener('change', function () {
          state.selectedMethodId = this.value;
          document.querySelectorAll('.method-card').forEach((card) => {
            const isMatch = card.getAttribute('data-method-id') === state.selectedMethodId;
            if (isMatch) {
              card.className = 'p-4 rounded-xl border cursor-pointer transition-all flex items-start gap-4 border-brand ring-2 ring-brand-soft bg-emerald-50/10 method-card';
            } else {
              card.className = 'p-4 rounded-xl border cursor-pointer transition-all flex items-start gap-4 border-line hover:border-line-2 bg-white method-card';
            }
          });
        });
      });
    }

    document.getElementById('btn-back-to-reasons')?.addEventListener('click', () => goToStep(3));
    document.getElementById('btn-proceed-to-review')?.addEventListener('click', () => goToStep(5));

    // Step 5: Render Review
    function renderReviewStep() {
      const selectedKeys = Object.keys(state.selectedItems);
      let subtotal = 0;

      let itemsHtml = '';
      selectedKeys.forEach((id) => {
        const item = state.order.items.find((i) => i.id === id);
        const itemState = state.selectedItems[id];
        if (!item) return;

        const lineTotal = item.price * itemState.quantity;
        subtotal += lineTotal;

        const reasonObj = REASONS.find((r) => r.code === itemState.reason);

        itemsHtml += `
          <div class="flex items-start justify-between gap-3 text-xs">
            <div class="flex items-start gap-2.5">
              <img src="${item.image}" alt="${item.name}" class="w-10 h-10 rounded border border-line object-cover shrink-0" />
              <div>
                <span class="font-bold text-ink">${item.name} (x${itemState.quantity})</span>
                <p class="text-muted">${item.variant}</p>
                <p class="text-brand-ink mt-0.5">Reason: ${reasonObj ? reasonObj.label : itemState.reason}</p>
                ${itemState.notes ? `<p class="text-ink-2 italic">“${itemState.notes}”</p>` : ''}
              </div>
            </div>
            <span class="font-mono font-semibold text-ink">$${lineTotal.toFixed(2)}</span>
          </div>
        `;
      });

      elements.reviewItemsList.innerHTML = itemsHtml;

      const methodObj = METHODS[state.selectedMethodId] || METHODS.prepaid_label;
      elements.reviewMethodName.textContent = methodObj.name;
      elements.reviewMethodCarrier.textContent = methodObj.carrier;
      elements.reviewMethodFee.textContent = 'Fee: ' + methodObj.feeLabel;

      let resolutionTitle = 'Original Payment Method';
      let resolutionDesc = 'Credited back to your card';
      if (state.selectedResolution === 'store_credit') {
        resolutionTitle = 'Store Gift Card (+10% Bonus)';
        resolutionDesc = 'Digital credit emailed instantly upon delivery';
      } else if (state.selectedResolution === 'exchange') {
        resolutionTitle = 'Variant Exchange';
        resolutionDesc = 'Replacement item shipped with free shipping';
      }

      elements.reviewResolutionTitle.textContent = resolutionTitle;
      elements.reviewResolutionDesc.textContent = resolutionDesc;

      // Calculate totals
      const fee = state.selectedResolution === 'store_credit' ? 0 : methodObj.fee;
      const bonus = state.selectedResolution === 'store_credit' ? (subtotal * 10) / 100 : 0;
      const totalRefund = Math.max(0, subtotal - fee + bonus);

      elements.calcSubtotal.textContent = '$' + subtotal.toFixed(2);
      elements.calcFee.textContent = fee === 0 ? 'FREE' : '-$' + fee.toFixed(2);
      elements.calcBonus.textContent = '+$' + bonus.toFixed(2);

      if (state.selectedResolution === 'store_credit') {
        elements.calcBonusRow.classList.remove('hidden');
      } else {
        elements.calcBonusRow.classList.add('hidden');
      }

      elements.calcTotal.textContent = '$' + totalRefund.toFixed(2);
    }

    document.getElementById('btn-edit-items')?.addEventListener('click', () => goToStep(2));
    document.getElementById('btn-edit-method')?.addEventListener('click', () => goToStep(4));
    document.getElementById('btn-edit-resolution')?.addEventListener('click', () => goToStep(4));
    document.getElementById('btn-back-to-method-step')?.addEventListener('click', () => goToStep(4));

    // Submit Return Action
    elements.btnSubmitReturn?.addEventListener('click', function () {
      // Show loading spinner
      elements.submitText.textContent = 'Submitting Return...';
      elements.submitIcon.classList.add('hidden');
      elements.submitSpinner.classList.remove('hidden');
      elements.btnSubmitReturn.setAttribute('disabled', 'true');

      setTimeout(() => {
        // Create mock submission
        const randomDigits = Math.floor(100000 + Math.random() * 900000);
        const returnId = 'RET-' + randomDigits;

        const submission = {
          returnId: returnId,
          orderNumber: state.order.orderNumber,
          customerEmail: state.order.email,
          customerName: state.order.customerName,
          status: 'return_approved',
          method: METHODS[state.selectedMethodId] || METHODS.prepaid_label,
          resolution: state.selectedResolution,
        };

        state.createdSubmission = submission;

        // Save to localStorage for status lookup page
        try {
          const stored = localStorage.getItem('qreturns_submissions');
          const map = stored ? JSON.parse(stored) : {};
          map[returnId] = submission;
          localStorage.setItem('qreturns_submissions', JSON.stringify(map));
        } catch (e) {
          console.warn(e);
        }

        // Reset submit button state
        elements.submitText.textContent = 'Submit Return Request';
        elements.submitIcon.classList.remove('hidden');
        elements.submitSpinner.classList.add('hidden');
        elements.btnSubmitReturn.removeAttribute('disabled');

        goToStep(6);
      }, 700);
    });

    // Step 6: Render Success
    function renderSuccessStep() {
      if (!state.createdSubmission) return;

      elements.successReturnId.textContent = state.createdSubmission.returnId;
      elements.successCustomerEmail.textContent = state.order.email;

      if (elements.btnTrackReturn) {
        elements.btnTrackReturn.href = '/status?id=' + state.createdSubmission.returnId;
      }

      // Send-by deadline (14 days from now)
      const deadline = new Date();
      deadline.setDate(deadline.getDate() + 14);
      const deadlineStr = deadline.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      const deadlineEl = document.getElementById('success-deadline');
      if (deadlineEl) deadlineEl.textContent = deadlineStr;
    }

    elements.btnDownloadLabel?.addEventListener('click', function () {
      alert('Return shipping label PDF downloaded to your device.');
    });

    elements.btnPrintQr?.addEventListener('click', function () {
      window.print();
    });

    document.getElementById('btn-start-another')?.addEventListener('click', function () {
      state.order = null;
      state.selectedItems = {};
      state.createdSubmission = null;
      if (elements.inputOrder) elements.inputOrder.value = '';
      if (elements.inputEmail) elements.inputEmail.value = '';
      goToStep(1);
    });
  })();
</script>
