              isEligible: false,
              ineligibleReason: 'Final sale item — excluded from standard returns policy',
            },
          ],
        },
        {
          id: 'ord_1088',
          orderNumber: '1088',
          email: 'alex.rivera@example.com',
          customerName: 'Alex Rivera',
