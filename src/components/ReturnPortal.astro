      btnDownloadLabel: document.getElementById('btn-download-label'),
      btnPrintQr: document.getElementById('btnPrintQr') || document.getElementById('btn-print-qr'),
    };

    // Helper: Show Error
    function showError(title, desc) {
      if (elements.errorBanner) {
        elements.errorTitle.textContent = title;
        elements.errorDesc.textContent = desc;
        elements.errorBanner.classList.remove('hidden');
        elements.errorBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    function clearError() {
      if (elements.errorBanner) {
        elements.errorBanner.classList.add('hidden');
      }
    }

    if (elements.errorClose) {
      elements.errorClose.addEventListener('click', clearError);
    }

    // Helper: Update Stepper UI
    function updateStepper(step) {
      state.currentStep = step;
      const totalSteps = 5;
      const pct = ((Math.min(step, 5) - 1) / (totalSteps - 1)) * 100;
      if (elements.stepperProgress) {
        elements.stepperProgress.style.width = pct + '%';
      }

      document.querySelectorAll('[data-step-indicator]').forEach((el) => {
        const s = parseInt(el.getAttribute('data-step-indicator'), 10);
        const circle = el.querySelector('[data-step-circle]');
        const label = el.querySelector('[data-step-label]');

        if (s < step) {
          circle.className = 'w-8 h-8 rounded-full flex items-center justify-center text-xs font-mono font-bold bg-brand text-white shadow-xs';
          circle.innerHTML = '<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>';
          if (label) label.className = 'mt-2 text-xs hidden sm:block font-medium tracking-tight text-brand-ink';
        } else if (s === step) {
          circle.className = 'w-8 h-8 rounded-full flex items-center justify-center text-xs font-mono font-bold bg-ink text-white ring-4 ring-brand-soft shadow-xs';
          circle.innerHTML = '<span>' + s + '</span>';
          if (label) label.className = 'mt-2 text-xs hidden sm:block font-bold tracking-tight text-ink';
        } else {
          circle.className = 'w-8 h-8 rounded-full flex items-center justify-center text-xs font-mono font-bold bg-white text-muted border border-line-2';
          circle.innerHTML = '<span>' + s + '</span>';
          if (label) label.className = 'mt-2 text-xs hidden sm:block font-medium tracking-tight text-faint';
        }
      });
    }

    // Step Transition
    function goToStep(step) {
      clearError();
      const allStepSections = [elements.step1, elements.step2, elements.step3, elements.step4, elements.step5, elements.step6];
      allStepSections.forEach((sec) => sec && sec.classList.add('hidden'));

      if (step === 1 && elements.step1) elements.step1.classList.remove('hidden');
      if (step === 2 && elements.step2) {
        renderOrderItems();
        elements.step2.classList.remove('hidden');
      }
      if (step === 3 && elements.step3) {
        renderReasonStep();
        elements.step3.classList.remove('hidden');
      }
      if (step === 4 && elements.step4) {
        updateResolutionAndMethodUI();
        elements.step4.classList.remove('hidden');
      }
      if (step === 5 && elements.step5) {
        renderReviewStep();
        elements.step5.classList.remove('hidden');
      }
      if (step === 6 && elements.step6) {
        renderSuccessStep();
        elements.step6.classList.remove('hidden');
      }

      updateStepper(step);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Quick Fill demo buttons
    document.querySelectorAll('.demo-fill-btn').forEach((btn) => {
      btn.addEventListener('click', function () {
        if (elements.inputOrder) elements.inputOrder.value = this.getAttribute('data-order') || '';
        if (elements.inputEmail) elements.inputEmail.value = this.getAttribute('data-email') || '';
        clearError();
        performLookup();
      });
    });

    // Lookup Logic
    function performLookup() {
      const orderNumRaw = (elements.inputOrder?.value || '').trim();
      const emailRaw = (elements.inputEmail?.value || '').trim().toLowerCase();

      if (!orderNumRaw) {
        showError('Order number required', 'Please enter your order number.');
        elements.inputOrder?.focus();
        return;
      }
      if (!emailRaw || !emailRaw.includes('@')) {
        showError('Valid email required', 'Please enter the email address used during checkout.');
        elements.inputEmail?.focus();
        return;
      }

      const cleanNum = orderNumRaw.replace(/^[#\s]+/, '').replace(/^ord[-_]?/i, '');

      // Mock lookup simulation
      const mockOrders = [
        {
          id: 'ord_1042',
