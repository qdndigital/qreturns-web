              quantity: 1,
              image: "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 80 80' fill='none'%3E%3Crect width='80' height='80' rx='12' fill='%23e6fcf5'/%3E%3Cpath d='M26 38C26 30.268 32.268 24 40 24C47.732 24 54 30.268 54 38V50C54 52.2091 52.2091 54 50 54H48V40H52V38C52 31.3726 46.6274 26 40 26C33.3726 26 28 31.3726 28 38V40H32V54H30C27.7909 54 26 52.2091 26 50V38Z' fill='%230ca678'/%3E%3C/svg%3E",
