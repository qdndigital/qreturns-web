---
import ReturnStepper from './ReturnStepper.astro';
import { RETURN_REASONS, RETURN_METHODS, RESOLUTION_OPTIONS, STORE_CONFIG } from '../lib/config';
import { MOCK_ORDERS } from '../lib/mock-data';
---

<div class="portal-wrap" id="qreturns-app">
  <!-- Interactive Stepper -->
  <ReturnStepper currentStep={1} />

  <!-- Error Banner -->
  <div
    id="portal-error-banner"
    class="hidden mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm flex items-start gap-3 transition-all"
    role="alert"
  >
    <svg class="w-5 h-5 text-red-600 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="12" y1="8" x2="12" y2="12"></line>
      <line x1="12" y1="16" x2="12.01" y2="16"></line>
    </svg>
    <div class="flex-grow">
      <p class="font-semibold" id="portal-error-title">Unable to proceed</p>
      <p class="text-xs text-red-700 mt-0.5" id="portal-error-desc">Please verify your information.</p>
    </div>
    <button type="button" id="portal-error-close" class="text-red-500 hover:text-red-800 p-1">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"></path></svg>
    </button>
  </div>

  <!-- ========================================================================= -->
  <!-- STEP 1: ORDER LOOKUP -->
  <!-- ========================================================================= -->
  <section id="step-1-lookup" class="portal-card">
    <div class="max-w-md mx-auto text-center mb-8">
      <span class="eyebrow"><span class="dot"></span> 30-Day Hassle-Free Returns</span>
      <h1 class="font-display font-bold text-2xl md:text-3xl text-ink mt-3">Start your return</h1>
      <p class="text-sm text-ink-2 mt-2 leading-relaxed">
        Pick your order, choose the items and a reason, and see how the item gets back to the store.
      </p>
    </div>

    <form id="order-lookup-form" class="max-w-md mx-auto space-y-4" onsubmit="return false;">
      <div>
        <label for="input-order-number" class="form-label">Order Number</label>
        <div class="relative">
          <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-muted text-sm font-mono font-medium">#</span>
          <input
            type="text"
            id="input-order-number"
            placeholder="1042"
            class="form-input pl-8 font-mono text-sm"
            required
            autocomplete="off"
          />
        </div>
        <p class="text-[11px] text-muted mt-1">Found on your order confirmation email or packing slip.</p>
      </div>

      <div>
        <label for="input-email" class="form-label">Email Address</label>
        <input
          type="email"
          id="input-email"
          placeholder="sarah.jenkins@example.com"
          class="form-input text-sm"
          required
          autocomplete="email"
        />
        <p class="text-[11px] text-muted mt-1">The email address used when placing the order.</p>
      </div>

      <button type="submit" id="btn-lookup-submit" class="btn btn-accent w-full mt-2 btn-lg">
        <span>Find My Order</span>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </form>

    <!-- Demo Quick-Fill Helpers -->
    <div class="mt-8 pt-6 border-t border-line text-center">
      <span class="kicker text-[11px]">Quick Demo Fill</span>
      <div class="flex flex-wrap items-center justify-center gap-2 mt-2.5">
        <button
          type="button"
          class="demo-fill-btn btn btn-line btn-sm text-xs font-mono"
          data-order="1042"
          data-email="sarah.jenkins@example.com"
        >
          #1042 · Sarah (Multi-item)
        </button>
        <button
          type="button"
          class="demo-fill-btn btn btn-line btn-sm text-xs font-mono"
          data-order="1088"
          data-email="alex.rivera@example.com"
        >
          #1088 · Alex (Fragrance)
        </button>
        <button
          type="button"
          class="demo-fill-btn btn btn-line btn-sm text-xs font-mono text-amber-800 bg-amber-50/60 border-amber-200 hover:bg-amber-100/60"
          data-order="1005"
          data-email="expired@example.com"
        >
          #1005 · Expired Window Demo
        </button>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- STEP 2: SELECT ITEMS -->
  <!-- ========================================================================= -->
  <section id="step-2-items" class="portal-card hidden">
    <!-- Order Meta Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-5 border-b border-line gap-3">
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-mono font-semibold px-2 py-0.5 rounded-md bg-bg-2 border border-line-2 text-ink" id="order-meta-number">Order #1042</span>
          <span class="badge badge-brand" id="order-meta-status">Delivered</span>
        </div>
        <p class="text-xs text-muted mt-1.5" id="order-meta-details">Delivered on Aug 15, 2026 to Sarah Jenkins</p>
      </div>
      <button type="button" class="btn btn-ghost btn-sm text-xs text-muted hover:text-ink self-start sm:self-auto" id="btn-change-order">
        Change Order
      </button>
    </div>

    <div class="my-6">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-base font-bold text-ink">Select items to return</h2>
        <span class="text-xs text-muted" id="eligible-count-label">Select at least 1 item</span>
      </div>

      <!-- Items List Container -->
      <div class="space-y-3" id="order-items-list">
        <!-- Rendered dynamically by JavaScript -->
      </div>
    </div>

    <!-- Action Bar -->
    <div class="pt-5 border-t border-line flex flex-col-reverse sm:flex-row sm:items-center justify-between gap-3">
      <button type="button" class="btn btn-line w-full sm:w-auto" id="btn-back-to-step-1">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        Back
      </button>
      <div class="flex items-center gap-3">
        <div class="text-right hidden sm:block">
          <span class="text-[11px] text-muted uppercase tracking-wider block">Estimated Value</span>
          <span class="text-sm font-bold text-ink" id="items-selected-value">$0.00</span>
        </div>
        <button type="button" class="btn btn-accent w-full sm:w-auto" id="btn-proceed-to-reasons" disabled>
          <span>Continue to Return Reasons</span>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- STEP 3: RETURN REASON -->
  <!-- ========================================================================= -->
  <section id="step-3-reasons" class="portal-card hidden">
    <div class="mb-6">
      <span class="eyebrow"><span class="dot"></span> Step 3 of 5</span>
      <h2 class="text-xl font-bold text-ink mt-1">Why are you returning these items?</h2>
      <p class="text-xs text-muted mt-1">Please select the reason for each item so we can improve our sizing and quality.</p>
    </div>

    <!-- Reasons per item -->
    <div class="space-y-6 mb-8" id="items-reasons-container">
      <!-- Rendered dynamically by JavaScript -->
    </div>

    <!-- Navigation -->
    <div class="pt-5 border-t border-line flex items-center justify-between">
      <button type="button" class="btn btn-line" id="btn-back-to-items">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        Back
      </button>
      <button type="button" class="btn btn-accent" id="btn-proceed-to-method">
        <span>Continue to Return Method</span>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- STEP 4: RETURN METHOD & RESOLUTION -->
  <!-- ========================================================================= -->
  <section id="step-4-method" class="portal-card hidden">
    <!-- Resolution Preference -->
    <div class="mb-8">
      <span class="eyebrow"><span class="dot"></span> How would you like your refund?</span>
      <h2 class="text-xl font-bold text-ink mt-1">Your refund</h2>
      <p class="text-xs text-muted mt-1">Refunds go back to your original payment method.</p>

      <div class="grid grid-cols-1 gap-3.5 mt-4" id="resolution-options-list">
        {RESOLUTION_OPTIONS.map((res, index) => (
          <label class={`relative p-4 rounded-xl border cursor-pointer transition-all flex flex-col justify-between ${
            index === 0 ? 'border-brand ring-2 ring-brand-soft bg-emerald-50/20' : 'border-line hover:border-line-2 bg-white'
          } resolution-card`} data-resolution-type={res.type}>
            <div>
              <div class="flex items-center justify-between mb-2">
                <input
                  type="radio"
                  name="resolution_choice"
                  value={res.type}
                  class="accent-brand w-4 h-4 cursor-pointer"
                  checked={index === 0}
                />
                {res.badge && (
                  <span class="badge badge-brand text-[10px]">{res.badge}</span>
                )}
              </div>
              <h3 class="text-sm font-bold text-ink">{res.title}</h3>
              <p class="text-xs text-ink-2 mt-1.5 leading-relaxed">{res.description}</p>
            </div>
            {res.bonusPercent && (
              <div class="mt-3 pt-2.5 border-t border-brand-line/60 text-xs font-semibold text-brand-ink flex items-center gap-1.5" id="store-credit-bonus-indicator">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
                <span>+10% Bonus added to refund</span>
              </div>
            )}
          </label>
        ))}
      </div>
    </div>

    <!-- Return Method Options -->
    <div class="mb-8 pt-6 border-t border-line">
      <span class="eyebrow"><span class="dot"></span> How will you return the items?</span>
      <h2 class="text-xl font-bold text-ink mt-1">Select return method</h2>
      <p class="text-xs text-muted mt-1">How your item gets back to the store.</p>

      <div class="space-y-3 mt-4" id="return-methods-list">
        {RETURN_METHODS.map((m, index) => (
          <label class={`p-4 rounded-xl border cursor-pointer transition-all flex items-start gap-4 ${
            index === 0 ? 'border-brand ring-2 ring-brand-soft bg-emerald-50/10' : 'border-line hover:border-line-2 bg-white'
          } method-card`} data-method-id={m.id}>
            <input
              type="radio"
              name="method_choice"
              value={m.id}
              class="accent-brand w-4 h-4 mt-1 cursor-pointer shrink-0"
              checked={index === 0}
            />
            <div class="flex-grow">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
                <div class="flex items-center gap-2">
                  <h3 class="text-sm font-bold text-ink">{m.name}</h3>
                  {m.noPrinterNeeded && (
                    <span class="badge badge-brand text-[10px]">No Printer Needed</span>
                  )}
                </div>
                <span class="text-xs font-mono font-semibold text-brand-ink">{m.feeLabel}</span>
              </div>
              <p class="text-xs text-ink-2 mt-1 leading-relaxed">{m.description}</p>
              <div class="flex items-center gap-4 mt-2 text-[11px] text-muted">
                <span class="flex items-center gap-1">
                  <svg class="w-3 h-3 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                  {m.carrier}
                </span>
                <span class="flex items-center gap-1">
                  <svg class="w-3 h-3 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                  {m.estimatedDays}
                </span>
              </div>
            </div>
          </label>
        ))}
      </div>
    </div>

    <!-- Navigation -->
    <div class="pt-5 border-t border-line flex items-center justify-between">
      <button type="button" class="btn btn-line" id="btn-back-to-reasons">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        Back
      </button>
      <button type="button" class="btn btn-accent" id="btn-proceed-to-review">
        <span>Review Return Summary</span>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- STEP 5: REVIEW RETURN -->
  <!-- ========================================================================= -->
  <section id="step-5-review" class="portal-card hidden">
    <div class="mb-6">
      <span class="eyebrow"><span class="dot"></span> Step 5 of 5</span>
      <h2 class="text-xl font-bold text-ink mt-1">Review your return request</h2>
      <p class="text-xs text-muted mt-1">Please confirm the items, reason, and return method before submitting.</p>
    </div>

    <!-- Review Grid -->
    <div class="space-y-6">
      <!-- Items Summary -->
      <div class="rounded-xl border border-line p-4 bg-bg-2">
        <div class="flex items-center justify-between pb-3 border-b border-line mb-3">
          <h3 class="text-xs font-bold uppercase tracking-wider text-ink-2">Items Being Returned</h3>
          <button type="button" class="text-xs font-semibold text-brand-ink hover:underline" id="btn-edit-items">Edit Items</button>
        </div>
        <div class="space-y-3" id="review-items-list">
          <!-- Rendered dynamically -->
        </div>
      </div>

      <!-- Return Method & Resolution Summary -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="rounded-xl border border-line p-4 bg-bg-2">
          <div class="flex items-center justify-between pb-2 border-b border-line mb-2.5">
            <h3 class="text-xs font-bold uppercase tracking-wider text-ink-2">Return Method</h3>
            <button type="button" class="text-xs font-semibold text-brand-ink hover:underline" id="btn-edit-method">Change</button>
          </div>
          <p class="text-sm font-semibold text-ink" id="review-method-name">Prepaid Shipping Label</p>
          <p class="text-xs text-muted mt-0.5" id="review-method-carrier">USPS / Happy Returns Bar</p>
          <p class="text-xs text-ink-2 mt-2" id="review-method-fee">Fee: FREE</p>
        </div>

        <div class="rounded-xl border border-line p-4 bg-bg-2">
          <div class="flex items-center justify-between pb-2 border-b border-line mb-2.5">
            <h3 class="text-xs font-bold uppercase tracking-wider text-ink-2">Refund Destination</h3>
            <button type="button" class="text-xs font-semibold text-brand-ink hover:underline" id="btn-edit-resolution">Change</button>
          </div>
          <p class="text-sm font-semibold text-ink" id="review-resolution-title">Original Payment Method</p>
          <p class="text-xs text-muted mt-0.5" id="review-resolution-desc">Credited back to your original payment method</p>
        </div>
      </div>

      <!-- Financial Calculation Box -->
      <div class="rounded-xl border border-brand-line bg-emerald-50/30 p-5 space-y-2.5">
        <h3 class="text-xs font-bold uppercase tracking-wider text-brand-ink mb-2">Estimated Refund Breakdown</h3>
        <div class="flex justify-between text-xs text-ink-2">
          <span>Items Value Subtotal:</span>
          <span class="font-mono font-medium text-ink" id="calc-subtotal">$0.00</span>
        </div>
        <div class="flex justify-between text-xs text-ink-2">
          <span>Return Shipping / Handling Fee:</span>
          <span class="font-mono font-medium" id="calc-fee">FREE</span>
        </div>
        <div class="hidden flex justify-between text-xs text-brand-ink font-medium" id="calc-bonus-row">
          <span>Store Credit Bonus (+10%):</span>
          <span class="font-mono" id="calc-bonus">+$0.00</span>
        </div>
        <div class="pt-2.5 border-t border-brand-line flex justify-between items-baseline">
          <span class="text-sm font-bold text-ink">Total Estimated Refund:</span>
          <span class="text-lg font-bold font-mono text-brand-ink" id="calc-total">$0.00</span>
        </div>
      </div>
    </div>

    <!-- Navigation & Submission -->
    <div class="pt-6 mt-6 border-t border-line flex items-center justify-between">
      <button type="button" class="btn btn-line" id="btn-back-to-method-step">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        Back
      </button>
      <button type="button" class="btn btn-accent btn-lg" id="btn-submit-return">
        <span id="submit-btn-text">Submit Return Request</span>
        <svg id="submit-btn-icon" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
        <svg id="submit-btn-spinner" class="w-4 h-4 animate-spin hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path>
        </svg>
      </button>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- STEP 6: CONFIRMATION & SUCCESS -->
  <!-- ========================================================================= -->
  <section id="step-6-success" class="portal-card hidden">
    <div class="text-center max-w-md mx-auto mb-8">
      <div class="w-14 h-14 rounded-full bg-emerald-100 border border-brand-line text-brand flex items-center justify-center mx-auto mb-4 shadow-sm animate-bounce-short">
        <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
      <span class="badge badge-brand mb-2">Return Authorized</span>
      <h2 class="font-display font-bold text-2xl md:text-3xl text-ink">Return Request Submitted!</h2>
      <p class="text-sm text-ink-2 mt-2 leading-relaxed">
        Your return reference is <strong class="font-mono text-ink font-bold" id="success-return-id">RET-894201</strong>. A confirmation email with your instructions has been sent to <span id="success-customer-email" class="font-medium text-ink">sarah.jenkins@example.com</span>.
      </p>
    </div>

    <!-- Label card -->
    <div class="max-w-lg mx-auto rounded-2xl border border-line bg-bg-2 p-6 text-center mb-8 shadow-xs">
      <span class="kicker text-[11px] block mb-2" id="success-method-kicker">Prepaid return label</span>
      <p class="text-sm text-ink-2 leading-relaxed">
        The store will review your request. When it is approved, your prepaid label is emailed to you with a link to your return's status page.
      </p>
      <!-- Kept for the demo script; the label is sent by email, not downloaded here. -->
      <button type="button" class="hidden" id="btn-download-label"></button>
      <button type="button" class="hidden" id="btn-print-qr"></button>
    </div>

    <!-- Next Steps Checklist -->
    <div class="max-w-lg mx-auto rounded-xl border border-line p-5 bg-white mb-8">
      <h3 class="text-sm font-bold text-ink mb-3 flex items-center gap-2">
        <svg class="w-4 h-4 text-brand-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
        What happens next
      </h3>
      <ol class="space-y-2.5 text-xs text-ink-2 pl-4 list-decimal marker:font-mono marker:font-bold marker:text-muted" id="success-instructions-list">
        <li>Wait for the store to approve your return. You will get an email.</li>
        <li>When your prepaid label arrives by email, pack the items securely and attach it.</li>
        <li>Drop the parcel off with the carrier.</li>
        <li>Please send it by <strong class="text-ink font-semibold" id="success-deadline">Sept 19, 2026</strong>.</li>
      </ol>
    </div>

    <!-- Bottom Actions -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-4 border-t border-line">
      <a href="#" id="btn-track-this-return" class="btn btn-brand w-full sm:w-auto">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        Track Live Return Status
      </a>
      <button type="button" id="btn-start-another" class="btn btn-ghost w-full sm:w-auto text-xs text-muted">
        Start Another Return
      </button>
    </div>
  </section>
</div>

<!-- ========================================================================= -->
<!-- CLIENT-SIDE SCRIPT: RETURN WIZARD LOGIC -->
<!-- ========================================================================= -->
<script is:inline>
  (function () {
    // Config & reasons data passed from server
    const REASONS = [
      { code: 'wrong_size', label: 'Wrong size (Too large / too small)' },
      { code: 'doesnt_fit', label: "Doesn't fit style / look" },
      { code: 'changed_mind', label: 'Changed my mind / No longer needed' },
      { code: 'damaged_item', label: 'Damaged item (Torn, stained, broken)' },
      { code: 'defective_item', label: 'Defective / Poor quality' },
      { code: 'wrong_item_received', label: 'Wrong item received' },
      { code: 'other', label: 'Other (Please specify)' },
    ];

    const METHODS = {
      prepaid_label: {
        id: 'prepaid_label',
        name: 'Prepaid Shipping Label',
        carrier: 'USPS via Shippo',
        fee: 0,
        feeLabel: 'FREE (Protect Product)',
        noPrinterNeeded: false,
      },
    };

    // Client Wizard State
    let state = {
      currentStep: 1,
      order: null,
      selectedItems: {}, // itemId -> { quantity, reason, notes }
      selectedResolution: 'original_payment',
      selectedMethodId: 'prepaid_label',
      createdSubmission: null,
    };

    // DOM Elements
    const elements = {
      stepperContainer: document.getElementById('return-stepper-container'),
      stepperProgress: document.getElementById('stepper-progress-line'),
      errorBanner: document.getElementById('portal-error-banner'),
      errorTitle: document.getElementById('portal-error-title'),
      errorDesc: document.getElementById('portal-error-desc'),
      errorClose: document.getElementById('portal-error-close'),
      step1: document.getElementById('step-1-lookup'),
      step2: document.getElementById('step-2-items'),
      step3: document.getElementById('step-3-reasons'),
      step4: document.getElementById('step-4-method'),
      step5: document.getElementById('step-5-review'),
      step6: document.getElementById('step-6-success'),
      inputOrder: document.getElementById('input-order-number'),
      inputEmail: document.getElementById('input-email'),
      btnLookup: document.getElementById('btn-lookup-submit'),
      orderMetaNumber: document.getElementById('order-meta-number'),
      orderMetaStatus: document.getElementById('order-meta-status'),
      orderMetaDetails: document.getElementById('order-meta-details'),
      orderItemsList: document.getElementById('order-items-list'),
      itemsSelectedValue: document.getElementById('items-selected-value'),
      btnProceedReasons: document.getElementById('btn-proceed-to-reasons'),
      itemsReasonsContainer: document.getElementById('items-reasons-container'),
      reviewItemsList: document.getElementById('review-items-list'),
      reviewMethodName: document.getElementById('review-method-name'),
      reviewMethodCarrier: document.getElementById('review-method-carrier'),
      reviewMethodFee: document.getElementById('review-method-fee'),
      reviewResolutionTitle: document.getElementById('review-resolution-title'),
      reviewResolutionDesc: document.getElementById('review-resolution-desc'),
      calcSubtotal: document.getElementById('calc-subtotal'),
      calcFee: document.getElementById('calc-fee'),
      calcBonus: document.getElementById('calc-bonus'),
      calcBonusRow: document.getElementById('calc-bonus-row'),
      calcTotal: document.getElementById('calc-total'),
      btnSubmitReturn: document.getElementById('btn-submit-return'),
      submitText: document.getElementById('submit-btn-text'),
      submitIcon: document.getElementById('submit-btn-icon'),
      submitSpinner: document.getElementById('submit-btn-spinner'),
      successReturnId: document.getElementById('success-return-id'),
