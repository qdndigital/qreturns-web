---
// Interactive preview of the three things Qreturns does:
// 1. Customer return flow — what return shipping costs in each situation
// 2. Merchant return rules & approval
// 3. Returns overview (sample figures)
---

<div class="rounded-3xl border border-line bg-white shadow-float overflow-hidden transition-all" id="portal-console">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between border-b border-line bg-bg-2 p-4 sm:px-6 gap-4">
    <div class="flex items-center gap-2">
      <span class="w-3 h-3 rounded-full bg-brand inline-block animate-pulse"></span>
      <span class="font-display font-bold text-sm text-ink">Qreturns Preview</span>
      <span class="font-mono text-[0.6875rem] uppercase text-muted px-2 py-0.5 rounded bg-white border border-line">
        Sample data
      </span>
    </div>

    <div class="flex items-center gap-1 bg-white p-1 rounded-xl border border-line w-full sm:w-auto overflow-x-auto" role="tablist">
      <button class="tab-btn active px-3.5 py-1.5 rounded-lg text-xs font-semibold text-ink transition-all cursor-pointer select-none" data-target="tab-customer" role="tab" aria-selected="true">
        1. Customer Return
      </button>
      <button class="tab-btn px-3.5 py-1.5 rounded-lg text-xs font-medium text-muted transition-all cursor-pointer select-none" data-target="tab-rules" role="tab" aria-selected="false">
        2. Rules & Approval
      </button>
      <button class="tab-btn px-3.5 py-1.5 rounded-lg text-xs font-medium text-muted transition-all cursor-pointer select-none" data-target="tab-analytics" role="tab" aria-selected="false">
        3. Returns Overview
      </button>
    </div>
  </div>

  <!-- Tab 1: what return shipping costs -->
  <div class="tab-pane p-6 sm:p-8" id="tab-customer">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-5 space-y-4">
        <div class="eyebrow"><span class="dot"></span> Return Shipping</div>
        <h3 class="font-display font-bold text-xl sm:text-2xl text-ink tracking-tight2">
          Clear about the cost before the customer commits.
        </h3>
        <p class="text-sm text-ink-2 leading-relaxed">
          Return shipping depends on the order and the products being returned. The customer sees the outcome on the Return Method step, before they confirm.
        </p>

        <div class="space-y-2 pt-2">
          <label class="font-mono text-xs uppercase font-semibold text-muted">Pick a situation:</label>
          <div class="grid grid-cols-1 gap-2.5" id="sim-scenario-picker">
            <button class="res-btn active p-3 rounded-xl border-2 border-brand bg-brand-soft/30 text-left flex items-center justify-between transition-all cursor-pointer" data-type="protect">
              <div class="flex items-center gap-2.5">
                <span class="w-4 h-4 rounded-full bg-brand text-white flex items-center justify-center text-[0.6rem] font-bold">✓</span>
                <div>
                  <div class="font-bold text-xs text-ink">Order has the Protect Product</div>
                  <div class="text-[0.7rem] text-muted">Free return shipping</div>
                </div>
              </div>
              <span class="font-mono font-bold text-sm text-brand-ink">Free</span>
            </button>

            <button class="res-btn p-3 rounded-xl border border-line bg-white hover:border-line-2 text-left flex items-center justify-between transition-all cursor-pointer" data-type="free">
              <div class="flex items-center gap-2.5">
                <span class="w-4 h-4 rounded-full border border-line-2 flex items-center justify-center text-[0.6rem] text-transparent">✓</span>
                <div>
                  <div class="font-bold text-xs text-ink">Product is on your Free Return list</div>
                  <div class="text-[0.7rem] text-muted">You pay for the label</div>
                </div>
              </div>
              <span class="font-mono font-bold text-sm text-ink">Free</span>
            </button>

            <button class="res-btn p-3 rounded-xl border border-line bg-white hover:border-line-2 text-left flex items-center justify-between transition-all cursor-pointer" data-type="paid">
              <div class="flex items-center gap-2.5">
                <span class="w-4 h-4 rounded-full border border-line-2 flex items-center justify-center text-[0.6rem] text-transparent">✓</span>
                <div>
                  <div class="font-bold text-xs text-ink">Any other order</div>
                  <div class="text-[0.7rem] text-muted">Customer pays the label price at checkout</div>
                </div>
              </div>
              <span class="font-mono font-bold text-sm text-muted">$7.50</span>
            </button>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="rounded-2xl border border-line bg-bg-2 p-5 sm:p-6 space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-line">
            <div>
              <div class="font-bold text-xs text-ink">Order #1042 · Summary</div>
              <div class="text-[0.7rem] text-muted">Inside your return window</div>
            </div>
            <span class="font-mono text-xs font-semibold text-brand-ink bg-white px-2 py-1 rounded border border-line" id="sim-status-badge">
              Waiting for approval
            </span>
          </div>

          <div class="flex items-center justify-between p-3 rounded-xl bg-white border border-line">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-gray-100 flex items-center justify-center text-base shrink-0">🧥</div>
              <div>
                <div class="font-semibold text-xs text-ink">All-Weather Utility Jacket</div>
                <div class="text-[0.7rem] text-muted">Reason: Size too small · Olive (M)</div>
              </div>
            </div>
            <div class="text-right">
              <div class="font-mono font-bold text-xs text-ink">$80.00</div>
              <div class="text-[0.65rem] text-muted">Qty: 1</div>
            </div>
          </div>

          <div class="p-4 rounded-xl bg-white border border-line space-y-2.5">
            <div class="flex items-center justify-between text-xs text-ink-2">
              <span>Item value:</span>
              <span class="font-mono font-medium">$80.00</span>
            </div>
            <div class="flex items-center justify-between text-xs text-ink-2">
              <span>Return shipping:</span>
              <span class="font-mono text-brand-ink font-semibold" id="sim-shipping-val">Free</span>
            </div>
            <div class="pt-2 border-t border-line flex items-center justify-between text-sm font-bold text-ink">
              <span>Refund to original payment method:</span>
              <span class="font-mono text-base text-brand-ink">$80.00</span>
            </div>
          </div>

          <div class="p-3 rounded-xl bg-white border border-line flex items-center justify-between gap-3">
            <div class="flex items-center gap-2.5">
              <div class="w-9 h-9 rounded-lg bg-ink text-white flex items-center justify-center font-mono font-bold text-xs shrink-0">↩</div>
              <div>
                <div class="font-bold text-xs text-ink" id="sim-method-title">Prepaid label on approval</div>
                <div class="text-[0.7rem] text-muted" id="sim-method-desc">Bought on your Shippo account and emailed to the customer</div>
              </div>
            </div>
            <span class="badge badge-brand text-[0.65rem] shrink-0">Label</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tab 2: rules -->
  <div class="tab-pane hidden p-6 sm:p-8" id="tab-rules">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-5 space-y-4">
        <div class="eyebrow"><span class="dot"></span> Return Rules</div>
        <h3 class="font-display font-bold text-xl sm:text-2xl text-ink tracking-tight2">
          Automate the easy ones. Decide the rest.
        </h3>
        <p class="text-sm text-ink-2 leading-relaxed">
          Set the return window, approve automatically what you always accept, and add a restocking fee or a return shipping fee. All of it is managed inside Shopify Admin.
        </p>

        <div class="space-y-3 pt-2">
          <div class="p-3.5 rounded-xl border border-line bg-bg-2/60 space-y-2">
            <div class="flex items-center justify-between text-xs font-semibold text-ink">
              <span>Return window</span>
              <span class="font-mono text-brand-ink">30 days</span>
            </div>
            <p class="text-[0.7rem] text-muted">Counted from the order, fulfilment or delivery date, as you choose</p>
          </div>

          <div class="p-3.5 rounded-xl border border-line bg-bg-2/60 space-y-2">
            <div class="flex items-center justify-between text-xs font-semibold text-ink">
              <span>Approve automatically</span>
              <span class="badge badge-brand text-[0.65rem]">On</span>
            </div>
            <p class="text-[0.7rem] text-muted">Returns open straight away and the label is bought</p>
          </div>

          <div class="p-3.5 rounded-xl border border-line bg-bg-2/60 space-y-2">
            <div class="flex items-center justify-between text-xs font-semibold text-ink">
              <span>Restocking fee</span>
              <span class="font-mono text-brand-ink">10% per item</span>
            </div>
            <p class="text-[0.7rem] text-muted">Taken off the refund automatically</p>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="rounded-2xl border border-line bg-bg-2 p-5 sm:p-6 space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-line">
            <div class="font-bold text-xs text-ink">How a request is decided</div>
            <span class="text-[0.6875rem] font-mono text-muted">Lowest order number first</span>
          </div>

          <div class="space-y-2.5">
            <div class="p-3.5 rounded-xl bg-white border border-brand-line flex items-center justify-between gap-3">
              <div class="flex items-start gap-2.5">
                <span class="w-5 h-5 rounded-full bg-brand-soft text-brand-ink flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">1</span>
                <div>
                  <div class="font-bold text-xs text-ink">Final sale items</div>
                  <div class="text-[0.7rem] text-muted">Items marked final sale or on your Non-Returnable list can't be returned</div>
                </div>
              </div>
              <span class="badge badge-faint text-[0.65rem] shrink-0">Blocked</span>
            </div>

            <div class="p-3.5 rounded-xl bg-white border border-line flex items-center justify-between gap-3">
              <div class="flex items-start gap-2.5">
                <span class="w-5 h-5 rounded-full bg-gray-100 text-ink flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">2</span>
                <div>
                  <div class="font-bold text-xs text-ink">Standard return policy</div>
                  <div class="text-[0.7rem] text-muted">Window: 30 days · Restocking fee: 10% · Auto-approve: on</div>
                </div>
              </div>
              <span class="badge badge-brand text-[0.65rem] shrink-0">Active</span>
            </div>

            <div class="p-3.5 rounded-xl bg-white border border-line flex items-center justify-between gap-3">
              <div class="flex items-start gap-2.5">
                <span class="w-5 h-5 rounded-full bg-gray-100 text-ink flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">3</span>
                <div>
                  <div class="font-bold text-xs text-ink">Free Return products</div>
                  <div class="text-[0.7rem] text-muted">No return shipping charge when every returned product is on the list</div>
                </div>
              </div>
              <span class="badge badge-brand text-[0.65rem] shrink-0">Free shipping</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tab 3: overview -->
  <div class="tab-pane hidden p-6 sm:p-8" id="tab-analytics">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-5 space-y-4">
        <div class="eyebrow"><span class="dot"></span> Returns Overview</div>
        <h3 class="font-display font-bold text-xl sm:text-2xl text-ink tracking-tight2">
          See what needs you, and how returns are trending.
        </h3>
        <p class="text-sm text-ink-2 leading-relaxed">
          The dashboard shows what is waiting for approval or inspection, the returns of the last 30 days and the money refunded. Analytics goes further back, by plan.
        </p>

        <div class="grid grid-cols-2 gap-3 pt-2">
          <div class="p-3.5 rounded-xl border border-line bg-bg-2">
            <div class="font-mono text-[0.65rem] uppercase text-muted">Needs action</div>
            <div class="font-display font-bold text-xl text-brand-ink mt-0.5">4</div>
            <div class="text-[0.6875rem] text-muted mt-0.5">Approve or inspect</div>
          </div>
          <div class="p-3.5 rounded-xl border border-line bg-bg-2">
            <div class="font-mono text-[0.65rem] uppercase text-muted">Returns (30 days)</div>
            <div class="font-display font-bold text-xl text-ink mt-0.5">23</div>
            <div class="text-[0.6875rem] text-muted mt-0.5">Sample figure</div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="rounded-2xl border border-line bg-bg-2 p-5 sm:p-6 space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-line">
            <div>
              <div class="font-bold text-xs text-ink">Latest returns</div>
              <div class="text-[0.7rem] text-muted">Sample data</div>
            </div>
            <span class="badge badge-brand text-[0.65rem]">Overview</span>
          </div>

          <div class="rounded-xl bg-white border border-line divide-y divide-line text-xs">
            <div class="flex items-center justify-between p-3.5">
              <div><div class="font-bold text-ink">R-1016-1</div><div class="text-[0.7rem] text-muted">#1016 · 27m ago</div></div>
              <span class="badge badge-warning text-[0.65rem]">Needs approval</span>
            </div>
            <div class="flex items-center justify-between p-3.5">
              <div><div class="font-bold text-ink">R-1014-1</div><div class="text-[0.7rem] text-muted">#1014 · 23h ago</div></div>
              <span class="badge badge-brand text-[0.65rem]">Completed</span>
            </div>
            <div class="flex items-center justify-between p-3.5">
              <div><div class="font-bold text-ink">R-1010-1</div><div class="text-[0.7rem] text-muted">#1010 · 2d ago</div></div>
              <span class="badge badge-faint text-[0.65rem]">Processing refund</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  document.querySelectorAll('#portal-console .tab-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var targetId = btn.getAttribute('data-target');
      document.querySelectorAll('#portal-console .tab-btn').forEach(function(b) {
        b.classList.remove('active', 'text-ink', 'font-semibold');
        b.classList.add('text-muted', 'font-medium');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active', 'text-ink', 'font-semibold');
      btn.classList.remove('text-muted', 'font-medium');
      btn.setAttribute('aria-selected', 'true');
      document.querySelectorAll('#portal-console .tab-pane').forEach(function(pane) { pane.classList.add('hidden'); });
      var activePane = document.getElementById(targetId);
      if (activePane) activePane.classList.remove('hidden');
    });
  });

  var SCENARIOS = {
    protect: { ship: 'Free', title: 'Prepaid label on approval', desc: 'Bought on your Shippo account and emailed to the customer', cls: 'text-brand-ink' },
    free: { ship: 'Free', title: 'Prepaid label on approval', desc: 'Every returned product is on your Free Return list, so you pay for the label', cls: 'text-brand-ink' },
    paid: { ship: '$7.50, paid at checkout', title: 'Pay the label price first', desc: 'The return is created once Shopify confirms the payment', cls: 'text-ink' }
  };
  document.querySelectorAll('#sim-scenario-picker .res-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var s = SCENARIOS[btn.getAttribute('data-type')];
      document.querySelectorAll('#sim-scenario-picker .res-btn').forEach(function(b) {
        b.classList.remove('active', 'border-2', 'border-brand', 'bg-brand-soft/30');
        b.classList.add('border', 'border-line', 'bg-white');
        var c = b.querySelector('.w-4');
        if (c) c.className = 'w-4 h-4 rounded-full border border-line-2 flex items-center justify-center text-[0.6rem] text-transparent';
      });
      btn.classList.add('active', 'border-2', 'border-brand', 'bg-brand-soft/30');
      btn.classList.remove('border-line', 'bg-white');
      var check = btn.querySelector('.w-4');
      if (check) check.className = 'w-4 h-4 rounded-full bg-brand text-white flex items-center justify-center text-[0.6rem] font-bold';
      var ship = document.getElementById('sim-shipping-val');
      if (ship) { ship.textContent = s.ship; ship.className = 'font-mono font-semibold ' + s.cls; }
      var t = document.getElementById('sim-method-title'); if (t) t.textContent = s.title;
      var d = document.getElementById('sim-method-desc'); if (d) d.textContent = s.desc;
    });
  });
</script>
