---
// Interactive Console demonstrating the 3 core pillars of QReturns:
// 1. Customer Self-Service Portal (Interactive Resolution Simulator)
// 2. Merchant Rules Engine (Configurable Policies & Auto-Approval)
// 3. Retained Revenue Analytics (Retained vs Refunded breakdown)
---

<div class="rounded-3xl border border-line bg-white shadow-float overflow-hidden transition-all" id="portal-console">
  <!-- Console Header & Tab Selector -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between border-b border-line bg-bg-2 p-4 sm:px-6 gap-4">
    <div class="flex items-center gap-2">
      <span class="w-3 h-3 rounded-full bg-green inline-block animate-pulse"></span>
      <span class="font-display font-bold text-sm text-ink">QReturns Live Engine</span>
      <span class="font-mono text-[0.6875rem] uppercase text-muted px-2 py-0.5 rounded bg-white border border-line">
        Interactive Preview
      </span>
    </div>

    <!-- Mode Tabs -->
    <div class="flex items-center gap-1 bg-white p-1 rounded-xl border border-line w-full sm:w-auto overflow-x-auto" role="tablist">
      <button
        class="tab-btn active px-3.5 py-1.5 rounded-lg text-xs font-semibold text-ink transition-all cursor-pointer select-none"
        data-target="tab-customer"
        role="tab"
        aria-selected="true"
      >
        1. Customer Portal
      </button>
      <button
        class="tab-btn px-3.5 py-1.5 rounded-lg text-xs font-medium text-muted transition-all cursor-pointer select-none"
        data-target="tab-rules"
        role="tab"
        aria-selected="false"
      >
        2. Rules & Auto-Approval
      </button>
      <button
        class="tab-btn px-3.5 py-1.5 rounded-lg text-xs font-medium text-muted transition-all cursor-pointer select-none"
        data-target="tab-analytics"
        role="tab"
        aria-selected="false"
      >
        3. Retained Revenue
      </button>
    </div>
  </div>

  <!-- Tab 1: Customer Self-Service Simulator -->
  <div class="tab-pane p-6 sm:p-8" id="tab-customer">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-5 space-y-4">
        <div class="eyebrow"><span class="dot"></span> Self-Service Resolution</div>
        <h3 class="font-display font-bold text-xl sm:text-2xl text-ink tracking-tight2">
          Turn refunds into future sales with one click.
        </h3>
        <p class="text-sm text-ink-2 leading-relaxed">
          Instead of defaulting to cash refunds, give shoppers attractive resolution incentives. When customers choose Store Credit, they get an instant bonus—keeping money in your store.
        </p>

        <div class="space-y-2 pt-2">
          <label class="font-mono text-xs uppercase font-semibold text-muted">Select Resolution Mode:</label>
          <div class="grid grid-cols-1 gap-2.5" id="sim-resolution-picker">
            <button
              class="res-btn active p-3 rounded-xl border-2 border-green bg-green-soft/30 text-left flex items-center justify-between transition-all cursor-pointer"
              data-type="credit"
            >
              <div class="flex items-center gap-2.5">
                <span class="w-4 h-4 rounded-full bg-green text-white flex items-center justify-center text-[0.6rem] font-bold">✓</span>
                <div>
                  <div class="font-bold text-xs text-ink flex items-center gap-1.5">
                    Store Gift Card
                    <span class="badge badge-green text-[0.65rem]">+10% Bonus</span>
                  </div>
                  <div class="text-[0.7rem] text-muted">Retains 100% of the sale value</div>
                </div>
              </div>
              <span class="font-mono font-bold text-sm text-green-ink">$88.00</span>
            </button>

            <button
              class="res-btn p-3 rounded-xl border border-line bg-white hover:border-line-2 text-left flex items-center justify-between transition-all cursor-pointer"
              data-type="exchange"
            >
              <div class="flex items-center gap-2.5">
                <span class="w-4 h-4 rounded-full border border-line-2 flex items-center justify-center text-[0.6rem] text-transparent">✓</span>
                <div>
                  <div class="font-bold text-xs text-ink">Exchange for Size Large</div>
                  <div class="text-[0.7rem] text-muted">Instant inventory reservation</div>
                </div>
              </div>
              <span class="font-mono font-bold text-sm text-ink">$0 diff</span>
            </button>

            <button
              class="res-btn p-3 rounded-xl border border-line bg-white hover:border-line-2 text-left flex items-center justify-between transition-all cursor-pointer"
              data-type="refund"
            >
              <div class="flex items-center gap-2.5">
                <span class="w-4 h-4 rounded-full border border-line-2 flex items-center justify-center text-[0.6rem] text-transparent">✓</span>
                <div>
                  <div class="font-bold text-xs text-ink">Original Payment Method</div>
                  <div class="text-[0.7rem] text-muted">Standard 3–5 day bank transfer</div>
                </div>
              </div>
              <span class="font-mono font-bold text-sm text-muted">$80.00</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Live Simulator Visual Card -->
      <div class="lg:col-span-7">
        <div class="rounded-2xl border border-line bg-bg-2 p-5 sm:p-6 space-y-4">
          <!-- Header of portal card -->
          <div class="flex items-center justify-between pb-3 border-b border-line">
            <div>
              <div class="font-bold text-xs text-ink">Order #1042 · Summary</div>
              <div class="text-[0.7rem] text-muted">Eligible for 30-day return</div>
            </div>
            <span class="font-mono text-xs font-semibold text-green-ink bg-white px-2 py-1 rounded border border-line" id="sim-status-badge">
              Auto-Approved ⚡
            </span>
          </div>

          <!-- Product Item -->
          <div class="flex items-center justify-between p-3 rounded-xl bg-white border border-line">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-gray-100 flex items-center justify-center text-base shrink-0">
                🧥
              </div>
              <div>
                <div class="font-semibold text-xs text-ink">All-Weather Utility Jacket</div>
                <div class="text-[0.7rem] text-muted">Reason: Size too small · Color: Olive (M)</div>
              </div>
            </div>
            <div class="text-right">
              <div class="font-mono font-bold text-xs text-ink">$80.00</div>
              <div class="text-[0.65rem] text-muted">Qty: 1</div>
            </div>
          </div>

          <!-- Payout & Outcome Box -->
          <div class="p-4 rounded-xl bg-white border border-line space-y-2.5">
            <div class="flex items-center justify-between text-xs text-ink-2">
              <span>Item Value:</span>
              <span class="font-mono font-medium">$80.00</span>
            </div>
            <div class="flex items-center justify-between text-xs text-green-ink" id="sim-bonus-row">
              <span class="flex items-center gap-1 font-medium">
                <span>+10% Store Credit Bonus:</span>
              </span>
              <span class="font-mono font-bold">+$8.00</span>
            </div>
            <div class="flex items-center justify-between text-xs text-ink-2" id="sim-shipping-row">
              <span>Return Shipping:</span>
              <span class="font-mono text-green-ink font-semibold">Free (USPS Drop-Off)</span>
            </div>
            <div class="pt-2 border-t border-line flex items-center justify-between text-sm font-bold text-ink">
              <span id="sim-total-label">Total Store Gift Card Value:</span>
              <span class="font-mono text-base text-green-ink" id="sim-total-val">$88.00</span>
            </div>
          </div>

          <!-- Generated Delivery Method -->
          <div class="p-3 rounded-xl bg-white border border-line flex items-center justify-between gap-3">
            <div class="flex items-center gap-2.5">
              <div class="w-9 h-9 rounded-lg bg-ink text-white flex items-center justify-center font-mono font-bold text-xs shrink-0">
                QR
              </div>
              <div>
                <div class="font-bold text-xs text-ink" id="sim-method-title">Instant Mobile QR Code Pass</div>
                <div class="text-[0.7rem] text-muted" id="sim-method-desc">No printer needed · Drop off at any USPS / carrier location</div>
              </div>
            </div>
            <span class="badge badge-green text-[0.65rem] shrink-0">Ready to Ship</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tab 2: Rules & Auto-Approval Simulator -->
  <div class="tab-pane hidden p-6 sm:p-8" id="tab-rules">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-5 space-y-4">
        <div class="eyebrow"><span class="dot"></span> Merchant Rules Engine</div>
        <h3 class="font-display font-bold text-xl sm:text-2xl text-ink tracking-tight2">
          Automate decisions. Stay in full control.
        </h3>
        <p class="text-sm text-ink-2 leading-relaxed">
          Configure return policies, set auto-approval criteria, define restocking fees per line item, or deduct fixed shipping fees—all executed natively in Shopify Admin.
        </p>

        <div class="space-y-3 pt-2">
          <div class="p-3.5 rounded-xl border border-line bg-bg-2/60 space-y-2">
            <div class="flex items-center justify-between text-xs font-semibold text-ink">
              <span>Return Window</span>
              <span class="font-mono text-green-ink">30 Days from Delivery</span>
            </div>
            <p class="text-[0.7rem] text-muted">Calculated from carrier delivery timestamp</p>
          </div>

          <div class="p-3.5 rounded-xl border border-line bg-bg-2/60 space-y-2">
            <div class="flex items-center justify-between text-xs font-semibold text-ink">
              <span>Auto-Approve Low Risk Returns</span>
              <span class="badge badge-green text-[0.65rem]">Enabled</span>
            </div>
            <p class="text-[0.7rem] text-muted">Instant label/QR generation for eligible orders</p>
          </div>

          <div class="p-3.5 rounded-xl border border-line bg-bg-2/60 space-y-2">
            <div class="flex items-center justify-between text-xs font-semibold text-ink">
              <span>Store Credit Bonus Incentive</span>
              <span class="font-mono text-green-ink">+10% Extra Credit</span>
            </div>
            <p class="text-[0.7rem] text-muted">Applied automatically to store credit resolutions</p>
          </div>
        </div>
      </div>

      <!-- Rules Evaluation Visual -->
      <div class="lg:col-span-7">
        <div class="rounded-2xl border border-line bg-bg-2 p-5 sm:p-6 space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-line">
            <div class="font-bold text-xs text-ink">Active Policy Rule Hierarchy</div>
            <span class="text-[0.6875rem] font-mono text-muted">3 Rules Evaluated</span>
          </div>

          <div class="space-y-2.5">
            <!-- Rule 1 -->
            <div class="p-3.5 rounded-xl bg-white border border-green-line flex items-center justify-between gap-3">
              <div class="flex items-start gap-2.5">
                <span class="w-5 h-5 rounded-full bg-green-soft text-green-ink flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">1</span>
                <div>
                  <div class="font-bold text-xs text-ink">Standard Apparel Return Policy</div>
                  <div class="text-[0.7rem] text-muted">Window: 30 days · Resolutions: Credit (+10%), Exchange, Refund · Auto-approve: ON</div>
                </div>
              </div>
              <span class="badge badge-green text-[0.65rem] shrink-0">Active</span>
            </div>

            <!-- Rule 2 -->
            <div class="p-3.5 rounded-xl bg-white border border-line flex items-center justify-between gap-3">
              <div class="flex items-start gap-2.5">
                <span class="w-5 h-5 rounded-full bg-gray-100 text-ink flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">2</span>
                <div>
                  <div class="font-bold text-xs text-ink">Final Sale & Clearance Exemption</div>
                  <div class="text-[0.7rem] text-muted">Tag: "final-sale" or discount &gt; 40% · Blocked from returns</div>
                </div>
              </div>
              <span class="badge badge-faint text-[0.65rem] shrink-0">Strict Rule</span>
            </div>

            <!-- Rule 3 -->
            <div class="p-3.5 rounded-xl bg-white border border-line flex items-center justify-between gap-3">
              <div class="flex items-start gap-2.5">
                <span class="w-5 h-5 rounded-full bg-gray-100 text-ink flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">3</span>
                <div>
                  <div class="font-bold text-xs text-ink">Keep Item / Green Return Rule</div>
                  <div class="text-[0.7rem] text-muted">Item price &lt; $15 or damaged · Customer keeps item · Instant store credit</div>
                </div>
              </div>
              <span class="badge badge-green text-[0.65rem] shrink-0">Cost Saver</span>
            </div>
          </div>

          <div class="p-3 rounded-xl bg-white border border-line text-xs text-ink-2 flex items-center justify-between">
            <span class="text-muted">Need a custom condition?</span>
            <span class="font-semibold text-green-ink">Rules evaluate in priority order</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tab 3: Retained Revenue Analytics -->
  <div class="tab-pane hidden p-6 sm:p-8" id="tab-analytics">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-5 space-y-4">
        <div class="eyebrow"><span class="dot"></span> Merchant Analytics</div>
        <h3 class="font-display font-bold text-xl sm:text-2xl text-ink tracking-tight2">
          Track retained value, not just return volume.
        </h3>
        <p class="text-sm text-ink-2 leading-relaxed">
          See exactly how much revenue your store protected from refunds. QReturns tracks retained GMV from exchanges and store credit in real time without heavy database queries.
        </p>

        <div class="grid grid-cols-2 gap-3 pt-2">
          <div class="p-3.5 rounded-xl border border-line bg-bg-2">
            <div class="font-mono text-[0.65rem] uppercase text-muted">Retained Rate</div>
            <div class="font-display font-bold text-xl text-green-ink mt-0.5">42.8%</div>
            <div class="text-[0.6875rem] text-muted mt-0.5">+14% vs. previous month</div>
          </div>
          <div class="p-3.5 rounded-xl border border-line bg-bg-2">
            <div class="font-mono text-[0.65rem] uppercase text-muted">Avg Processing</div>
            <div class="font-display font-bold text-xl text-ink mt-0.5">&lt; 4 mins</div>
            <div class="text-[0.6875rem] text-muted mt-0.5">With auto-approval</div>
          </div>
        </div>
      </div>

      <!-- Visual Analytics Dashboard -->
      <div class="lg:col-span-7">
        <div class="rounded-2xl border border-line bg-bg-2 p-5 sm:p-6 space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-line">
            <div>
              <div class="font-bold text-xs text-ink">Last 30 Days Financial Summary</div>
              <div class="text-[0.7rem] text-muted">Total Return Volume: 142 orders ($11,260)</div>
            </div>
            <span class="badge badge-green text-[0.65rem]">Live Rollup</span>
          </div>

          <!-- Progress bar / visual comparison -->
          <div class="space-y-2 p-4 rounded-xl bg-white border border-line">
            <div class="flex items-center justify-between text-xs">
              <span class="font-bold text-green-ink flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-green"></span>
                Revenue Kept (Credit + Exchange)
              </span>
              <span class="font-mono font-bold text-green-ink">$4,820 (42.8%)</span>
            </div>

            <!-- Bar -->
            <div class="w-full h-3 rounded-full bg-gray-100 overflow-hidden flex">
              <div class="h-full bg-green" style="width: 42.8%;"></div>
              <div class="h-full bg-gray-300" style="width: 57.2%;"></div>
            </div>

            <div class="flex items-center justify-between text-xs pt-1">
              <span class="text-muted flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-gray-400"></span>
                Refunded to Original Payment
              </span>
              <span class="font-mono text-muted">$6,440 (57.2%)</span>
            </div>
          </div>

          <!-- Breakdown by Reason -->
          <div class="p-4 rounded-xl bg-white border border-line space-y-2">
            <div class="font-bold text-xs text-ink mb-2">Top Return Reasons:</div>
            <div class="space-y-1.5 text-xs text-ink-2">
              <div class="flex items-center justify-between">
                <span>Size too small / large (Fit issue)</span>
                <span class="font-mono font-semibold text-ink">54% → 72% converted to exchange</span>
              </div>
              <div class="w-full h-1.5 rounded-full bg-gray-100 overflow-hidden">
                <div class="h-full bg-green" style="width: 54%;"></div>
              </div>

              <div class="flex items-center justify-between pt-1">
                <span>Changed mind / Style preference</span>
                <span class="font-mono font-semibold text-ink">28% → 58% converted to credit</span>
              </div>
              <div class="w-full h-1.5 rounded-full bg-gray-100 overflow-hidden">
                <div class="h-full bg-blue-500" style="width: 28%;"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  // Tab switcher
  document.querySelectorAll('#portal-console .tab-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var targetId = btn.getAttribute('data-target');
      document.querySelectorAll('#portal-console .tab-btn').forEach(function(b) {
        b.classList.remove('active', 'text-ink', 'font-semibold');
        b.classList.add('text-muted', 'font-medium');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active', 'text-ink', 'font-semibold');
      btn.classList.remove('text-muted', 'font-medium');
      btn.setAttribute('aria-selected', 'true');

      document.querySelectorAll('#portal-console .tab-pane').forEach(function(pane) {
        pane.classList.add('hidden');
      });
      var activePane = document.getElementById(targetId);
      if (activePane) activePane.classList.remove('hidden');
    });
  });

  // Simulator resolution switcher
  document.querySelectorAll('#sim-resolution-picker .res-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var type = btn.getAttribute('data-type');
      document.querySelectorAll('#sim-resolution-picker .res-btn').forEach(function(b) {
        b.classList.remove('active', 'border-2', 'border-green', 'bg-green-soft/30');
        b.classList.add('border', 'border-line', 'bg-white');
        var check = b.querySelector('.w-4');
        if (check) {
          check.className = 'w-4 h-4 rounded-full border border-line-2 flex items-center justify-center text-[0.6rem] text-transparent';
        }
      });
      btn.classList.add('active', 'border-2', 'border-green', 'bg-green-soft/30');
      btn.classList.remove('border-line', 'bg-white');
      var check = btn.querySelector('.w-4');
      if (check) {
        check.className = 'w-4 h-4 rounded-full bg-green text-white flex items-center justify-center text-[0.6rem] font-bold';
      }

      var bonusRow = document.getElementById('sim-bonus-row');
      var totalLabel = document.getElementById('sim-total-label');
      var totalVal = document.getElementById('sim-total-val');
      var methodTitle = document.getElementById('sim-method-title');
      var methodDesc = document.getElementById('sim-method-desc');

      if (type === 'credit') {
        if (bonusRow) bonusRow.style.display = 'flex';
        if (totalLabel) totalLabel.textContent = 'Total Store Gift Card Value:';
        if (totalVal) {
          totalVal.textContent = '$88.00';
          totalVal.className = 'font-mono text-base text-green-ink';
        }
        if (methodTitle) methodTitle.textContent = 'Instant Mobile QR Code Pass';
        if (methodDesc) methodDesc.textContent = 'No printer needed · Drop off at any USPS / carrier location';
      } else if (type === 'exchange') {
        if (bonusRow) bonusRow.style.display = 'none';
        if (totalLabel) totalLabel.textContent = 'New Item (Size Large):';
        if (totalVal) {
          totalVal.textContent = '$0.00 Balance';
          totalVal.className = 'font-mono text-base text-ink';
        }
        if (methodTitle) methodTitle.textContent = 'Prepaid Return Label + Instant Exchange';
        if (methodDesc) methodDesc.textContent = 'New size ships immediately once return is scanned';
      } else if (type === 'refund') {
        if (bonusRow) bonusRow.style.display = 'none';
        if (totalLabel) totalLabel.textContent = 'Refund to Visa ending in 4092:';
        if (totalVal) {
          totalVal.textContent = '$80.00';
          totalVal.className = 'font-mono text-base text-muted';
        }
        if (methodTitle) methodTitle.textContent = 'Prepaid Mail-in Label';
        if (methodDesc) methodDesc.textContent = 'Refund released 3–5 days after inspection';
      }
    });
  });
</script>
