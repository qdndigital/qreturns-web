---
// Hero visual representing both sides of QReturns:
// 1. The customer self-service return wizard with +10% store credit bonus & QR drop-off
// 2. The merchant Polaris admin overview with retained revenue metrics & auto-approval
---

<div class="relative w-full max-w-[560px] mx-auto lg:max-w-none select-none">
  <!-- Soft Glow behind mockup -->
  <div class="absolute -inset-4 bg-gradient-to-tr from-green-soft to-transparent rounded-3xl -z-10 opacity-70 blur-xl"></div>

  <!-- Primary Customer Portal Window -->
  <div class="rounded-2xl border border-line bg-white shadow-float overflow-hidden transition-all duration-300 hover:shadow-glow">
    <!-- Window Titlebar -->
    <div class="flex items-center justify-between px-4 py-3 border-b border-line bg-bg-2">
      <div class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f56]"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e]"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-[#27c93f]"></span>
      </div>
      <div class="flex items-center gap-1.5 px-3 py-1 rounded-md bg-white border border-line text-[0.7rem] font-mono text-muted">
        <span class="w-1.5 h-1.5 rounded-full bg-green"></span>
        <span>your-brand.com/apps/returns</span>
      </div>
      <span class="text-[0.6875rem] font-mono font-medium text-green-ink bg-green-soft px-2 py-0.5 rounded border border-green-line">
        Order #1042
      </span>
    </div>

    <!-- Portal Body -->
    <div class="p-5 sm:p-6 space-y-4">
      <!-- Item selection row -->
      <div class="flex items-center justify-between p-3 rounded-xl border border-line bg-bg-2/50">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-lg bg-gray-100 border border-line flex items-center justify-center text-lg overflow-hidden shrink-0">
            👕
          </div>
          <div>
            <div class="font-semibold text-xs text-ink">Heavyweight Studio Tee</div>
            <div class="text-[0.7rem] text-muted">Size: M · Color: Forest Green</div>
            <div class="text-[0.7rem] font-medium text-ink mt-0.5">$50.00</div>
          </div>
        </div>
        <span class="badge badge-green text-[0.65rem] shrink-0">Selected for Return</span>
      </div>

      <!-- Resolution options (Incentivized) -->
      <div class="space-y-2">
        <div class="text-[0.7rem] font-mono uppercase tracking-wider text-muted flex items-center justify-between">
          <span>Selected Resolution</span>
          <span class="text-green-ink font-semibold">Recommended</span>
        </div>

        <!-- Store Credit (Selected) -->
        <div class="p-3 rounded-xl border-2 border-green bg-green-soft/30 flex items-center justify-between relative shadow-xs">
          <div class="flex items-start gap-2.5">
            <div class="w-4 h-4 rounded-full bg-green text-white flex items-center justify-center text-[0.6rem] font-bold mt-0.5 shrink-0">
              ✓
            </div>
            <div>
              <div class="flex items-center gap-2">
                <span class="font-bold text-xs text-ink">Store Gift Card</span>
                <span class="inline-block font-mono text-[0.65rem] font-bold text-green-ink bg-green-soft border border-green-line px-1.5 py-0.2 rounded-full">
                  +10% Bonus ($5.00)
                </span>
              </div>
              <p class="text-[0.7rem] text-ink-2 mt-0.5">
                Instant delivery to your email · No expiration
              </p>
            </div>
          </div>
          <div class="text-right shrink-0">
            <div class="font-bold text-sm text-green-ink tabular-nums">$55.00</div>
            <div class="text-[0.65rem] text-muted line-through">$50.00</div>
          </div>
        </div>

        <!-- Other options preview -->
        <div class="grid grid-cols-2 gap-2">
          <div class="p-2.5 rounded-lg border border-line bg-white text-xs text-muted flex items-center justify-between opacity-80">
            <span class="text-[0.7rem]">Exchange Size (L)</span>
            <span class="text-[0.65rem] font-mono">$0 diff</span>
          </div>
          <div class="p-2.5 rounded-lg border border-line bg-white text-xs text-muted flex items-center justify-between opacity-80">
            <span class="text-[0.7rem]">Original Refund</span>
            <span class="text-[0.65rem] font-mono">$50.00</span>
          </div>
        </div>
      </div>

      <!-- Shipping / Drop-off Pass -->
      <div class="pt-2 border-t border-line flex items-center justify-between text-xs">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-ink text-white flex items-center justify-center text-xs font-mono font-bold">
            QR
          </div>
          <div>
            <div class="font-bold text-ink text-[0.75rem]">Mobile Drop-off Pass</div>
            <div class="text-[0.6875rem] text-muted">No printer needed · USPS / Drop-off</div>
          </div>
        </div>
        <span class="font-mono text-[0.7rem] font-bold text-green-ink bg-green-soft px-2 py-1 rounded border border-green-line">
          Auto-Approved ⚡
        </span>
      </div>
    </div>
  </div>

  <!-- Floating Merchant KPI Badge (Bottom-Right overlay) -->
  <div class="hidden sm:flex absolute -bottom-6 -right-4 md:-right-6 bg-white rounded-2xl border border-line p-4 shadow-float items-center gap-4 max-w-[300px] backdrop-blur-md">
    <div class="w-10 h-10 rounded-xl bg-green-soft flex items-center justify-center text-green-ink shrink-0 font-bold">
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
        <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
      </svg>
    </div>
    <div>
      <div class="font-mono text-[0.65rem] uppercase tracking-wider text-muted">Shopify Merchant Impact</div>
      <div class="font-display font-bold text-base text-ink flex items-center gap-1.5">
        <span>$4,820</span>
        <span class="text-[0.7rem] font-mono font-semibold text-green-ink bg-green-soft px-1.5 py-0.2 rounded border border-green-line">
          42% Kept
        </span>
      </div>
      <div class="text-[0.6875rem] text-ink-2">Revenue saved from refunds this month</div>
    </div>
  </div>
</div>
