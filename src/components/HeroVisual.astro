---
// Hero visual representing both sides of Qreturns:
// 1. The customer self-service return flow (refund, prepaid label)
// 2. A small merchant overview badge
---

<div class="relative w-full max-w-[560px] mx-auto lg:max-w-none select-none">
  <!-- Soft Glow behind mockup -->
  <div class="absolute -inset-4 bg-gradient-to-tr from-brand-soft to-transparent rounded-3xl -z-10 opacity-70 blur-xl"></div>

  <!-- Primary Customer Portal Window -->
  <div class="rounded-2xl border border-line bg-white shadow-float overflow-hidden transition-all duration-300 hover:shadow-glow">
    <!-- Window Titlebar -->
    <div class="flex items-center justify-between px-4 py-3 border-b border-line bg-bg-2">
      <div class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f56]"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e]"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-[#27c93f]"></span>
      </div>
      <div class="flex items-center gap-1.5 px-3 py-1 rounded-md bg-white border border-line text-[0.7rem] font-mono text-muted">
        <span class="w-1.5 h-1.5 rounded-full bg-brand"></span>
        <span>your-brand.com/apps/returns</span>
      </div>
      <span class="text-[0.6875rem] font-mono font-medium text-brand-ink bg-brand-soft px-2 py-0.5 rounded border border-brand-line">
        Order #1042
      </span>
    </div>

    <!-- Portal Body -->
    <div class="p-5 sm:p-6 space-y-4">
      <!-- Item selection row -->
      <div class="flex items-center justify-between p-3 rounded-xl border border-line bg-bg-2/50">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-lg bg-gray-100 border border-line flex items-center justify-center text-lg overflow-hidden shrink-0">
            👕
          </div>
          <div>
            <div class="font-semibold text-xs text-ink">Heavyweight Studio Tee</div>
            <div class="text-[0.7rem] text-muted">Size: M · Color: Forest Green</div>
            <div class="text-[0.7rem] font-medium text-ink mt-0.5">$50.00</div>
          </div>
        </div>
        <span class="badge badge-brand text-[0.65rem] shrink-0">Selected for Return</span>
      </div>

      <!-- Resolution -->
      <div class="space-y-2">
        <div class="text-[0.7rem] font-mono uppercase tracking-wider text-muted flex items-center justify-between">
          <span>Refund</span>
          <span class="text-brand-ink font-semibold">To original payment method</span>
        </div>

        <div class="p-3 rounded-xl border-2 border-brand bg-brand-soft/30 flex items-center justify-between relative shadow-xs">
          <div class="flex items-start gap-2.5">
            <div class="w-4 h-4 rounded-full bg-brand text-white flex items-center justify-center text-[0.6rem] font-bold mt-0.5 shrink-0">✓</div>
            <div>
              <span class="font-bold text-xs text-ink">Original payment method</span>
              <p class="text-[0.7rem] text-ink-2 mt-0.5">Refunded by Shopify after you inspect the parcel</p>
            </div>
          </div>
          <div class="text-right shrink-0">
            <div class="font-bold text-sm text-brand-ink tabular-nums">$50.00</div>
          </div>
        </div>
      </div>

      <!-- Shipping label -->
      <div class="pt-2 border-t border-line flex items-center justify-between text-xs">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-ink text-white flex items-center justify-center text-xs font-mono font-bold">
            ↩
          </div>
          <div>
            <div class="font-bold text-ink text-[0.75rem]">Prepaid return label</div>
            <div class="text-[0.6875rem] text-muted">Free with the Protect Product · USPS via Shippo</div>
          </div>
        </div>
        <span class="font-mono text-[0.7rem] font-bold text-brand-ink bg-brand-soft px-2 py-1 rounded border border-brand-line">
          Approved
        </span>
      </div>
    </div>
  </div>

  <!-- Floating Merchant KPI Badge (Bottom-Right overlay) -->
  <div class="hidden sm:flex absolute -bottom-6 -right-4 md:-right-6 bg-white rounded-2xl border border-line p-4 shadow-float items-center gap-4 max-w-[300px] backdrop-blur-md">
    <div class="w-10 h-10 rounded-xl bg-brand-soft flex items-center justify-center text-brand-ink shrink-0 font-bold">
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
        <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
      </svg>
    </div>
    <div>
      <div class="font-mono text-[0.65rem] uppercase tracking-wider text-muted">Returns this month</div>
      <div class="font-display font-bold text-base text-ink flex items-center gap-1.5">
        <span>23 returns</span>
        <span class="text-[0.7rem] font-mono font-semibold text-brand-ink bg-brand-soft px-1.5 py-0.2 rounded border border-brand-line">
          4 need action
        </span>
      </div>
      <div class="text-[0.6875rem] text-ink-2">Approve, inspect and refund in Shopify</div>
    </div>
  </div>
</div>
