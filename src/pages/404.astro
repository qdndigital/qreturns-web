---
import Base from '../layouts/Base.astro';
---

<Base title="Page Not Found — Return Portal">
  <div class="portal-wrap py-20 text-center">
    <div class="portal-card max-w-md mx-auto">
      <span class="eyebrow"><span class="dot"></span> 404 Error</span>
      <h1 class="font-display font-bold text-3xl text-ink mt-3">Page Not Found</h1>
      <p class="text-xs text-muted mt-2 leading-relaxed">
        The page you are looking for doesn't exist or has moved.
      </p>
      <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="/" class="btn btn-accent btn-sm w-full sm:w-auto">Start a Return</a>
        <a href="/status" class="btn btn-line btn-sm w-full sm:w-auto">Track Status</a>
      </div>
    </div>
  </div>
</Base>
