---
import Base from '../layouts/Base.astro';
import { APP_STORE_URL, DEMO_URL, SITE_NAME, SUPPORT_EMAIL } from '../consts';

const title = `Frequently Asked Questions — ${SITE_NAME}`;
const description = 'Common questions and answers about setting up Qreturns on Shopify, App Proxy configuration, return policies, per-product rules, and shipping labels.';
---

<Base title={title} description={description}>
  <section class="phero">
    <div class="wrap">
      <div class="crumb"><a href="/">~</a> / faq</div>
      <h1>Frequently Asked <em>Questions</em></h1>
      <p>
        Everything you need to know about setting up Qreturns on your Shopify store, managing return policies, and giving customers a delightful self-service experience.
      </p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <!-- Merchant Setup & Shopify Questions -->
      <div class="max-w-3xl mx-auto space-y-12">
        <div>
          <div class="eyebrow mb-3"><span class="dot"></span> Merchant Setup & Shopify</div>
          <h2 class="font-display font-bold text-xl sm:text-2xl text-ink mb-6">Installing & Configuring Qreturns</h2>

          <div class="faq">
            <details open>
              <summary>
                <span>How long does it take to install and launch Qreturns?</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <p>
                Less than 2 minutes. Install Qreturns from the Shopify App Store, configure your desired return window (e.g. 30 days) and resolutions, and your portal is immediately live at <code>yourstore.com/apps/returns</code> with zero code or theme edits required.
              </p>
            </details>

            <details>
              <summary>
                <span>Does Qreturns require modifying my Shopify theme?</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <p>
                No theme code modifications are necessary. Qreturns operates natively through the Shopify App Proxy. You can easily add a link to your return portal in your website's navigation header, footer menu, or order confirmation emails.
              </p>
            </details>

            <details>
              <summary>
                <span>How do return rules and auto-approval work?</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <p>
                You can create rules based on product tags, collections, return window elapsed days, or return reasons. Return requests that satisfy your rules can be approved automatically, and a prepaid label is bought for them when one applies, without you lifting a finger.
              </p>
            </details>

            <details>
              <summary>
                <span>What can customers ask for?</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <p>
                Today customers request a refund to the original payment method. Store credit and exchanges are being finished and aren't offered to customers yet.
              </p>
            </details>

            <details>
              <summary>
                <span>Can I mark some products as not returnable, or free to return?</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <p>
                Yes. In Settings → Product policy you can put products on a Free Return list (no return shipping charge) or a Non-Returnable list. Products on neither list follow your normal return policy.
              </p>
            </details>

            <details>
              <summary>
                <span>Who pays for the return label?</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <p>
                You do for orders with the Protect Product and for Free Return products. For any other order the customer pays the label price at a Shopify checkout before the return is created. Labels are bought on your own Shippo account.
              </p>
            </details>
          </div>
        </div>

        <!-- Customer Experience Questions -->
        <div id="policies">
          <div class="eyebrow mb-3"><span class="dot"></span> Customer Experience</div>
          <h2 class="font-display font-bold text-xl sm:text-2xl text-ink mb-6">Customer Returns</h2>

          <div class="faq">
            <details>
              <summary>
                <span>How do customers find their order in the portal?</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <p>
                Customers sign in with their store account and see a list of their own orders, each with a Return button.
              </p>
            </details>

            <details>
              <summary>
                <span>Do customers need an account?</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <p>
                Yes, a store account. Signing in is what makes sure only the owner of an order can return it.
              </p>
            </details>

            <details>
              <summary>
                <span>How do customers track the progress of their return?</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <p>
                Each return gets a return number (like <code>R-1016-1</code>) and a status page. Customers also get email updates when the return is approved, the label is ready, and the refund is done.
              </p>
            </details>
          </div>
        </div>

        <!-- Still have questions box -->
        <div class="p-6 md:p-8 rounded-2xl border border-line bg-bg-2 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div>
            <h3 class="font-display font-bold text-base text-ink">Have a specific question about your store setup?</h3>
            <p class="text-xs text-muted mt-1">Our support engineers are available to help you configure custom policies.</p>
          </div>
          <a href={`mailto:${SUPPORT_EMAIL}`} class="btn btn-accent btn-sm shrink-0">
            Contact Support
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="sec alt">
    <div class="wrap">
      <div class="cta-box rv">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-4">
          Ready to simplify your Shopify returns?
        </h2>
        <p class="text-gray-300 text-base max-w-xl mx-auto mb-8">
          Install Qreturns today with 14 days of full Growth access.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a href={APP_STORE_URL} class="btn btn-brand btn-lg">Install on Shopify Free</a>
          <a href={DEMO_URL} class="btn btn-line btn-lg" style="background: rgba(255,255,255,0.1); color: #fff; border-color: rgba(255,255,255,0.2);">
            Try live demo
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
