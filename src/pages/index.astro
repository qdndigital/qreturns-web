---
import Base from '../layouts/Base.astro';
import HeroVisual from '../components/HeroVisual.astro';
import PortalConsole from '../components/PortalConsole.astro';
import { APP_STORE_URL, DEMO_URL, SITE_NAME, TAGLINE } from '../consts';
import { PLANS, REVERSE_TRIAL_DAYS, PAYMENT_TRIAL_DAYS, TEASER_BULLETS } from '../plans';

const title = `${SITE_NAME} — Returns & Exchanges for Shopify Merchants`;
const description = 'Automate returns, exchanges, store credit bonuses, and reverse shipping labels on Shopify. Give customers a self-service portal on your domain and retain up to 40%+ return revenue.';

const checkIcon = '<svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg>';
const crossIcon = '<svg viewBox="0 0 24 24"><path d="M6 6l12 12M6 18L18 6"/></svg>';
---

<Base title={title} description={description}>
  <!-- ===================== HERO ===================== -->
  <section class="hero">
    <div class="wrap herogrid">
      <div class="hero-copy">
        <span class="eyebrow"><span class="dot"></span> Built for Shopify</span>
        <h1>Turn product returns into <em>retained revenue.</em></h1>
        <p class="lead">
          QReturns gives your customers a fast self-service return portal on your domain, automates exchanges and bonus store credit to keep revenue in your store, and streamlines returns inside Shopify Admin.
        </p>
        <div class="hero-cta">
          <a href={APP_STORE_URL} class="btn btn-accent btn-lg">
            Install free <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a href={DEMO_URL} class="btn btn-line btn-lg">
            Try live demo
          </a>
        </div>
        <p class="hero-note">
          Free plan forever · {REVERSE_TRIAL_DAYS} days full access on install · No card required · Zero theme code
        </p>
      </div>

      <div class="hero-viz">
        <HeroVisual />
      </div>
    </div>
  </section>

  <!-- ===================== TRUST BAR ===================== -->
  <section class="py-2">
    <div class="wrap">
      <div class="trustbar rv">
        <span class="ti">
          <svg viewBox="0 0 24 24"><path d="M12 3l8 4v6c0 5-4 7-8 8-4-1-8-3-8-8V7z"/></svg>
          Built for Shopify
        </span>
        <span class="sep"></span>
        <span class="ti">
          <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6l-10 7L2 6"/></svg>
          Shopify App Proxy (On Your Domain)
        </span>
        <span class="sep"></span>
        <span class="ti">
          <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/></svg>
          Free Plan Forever
        </span>
        <span class="sep"></span>
        <span class="ti">
          <svg viewBox="0 0 24 24"><path d="M13 2L3 14h7l-1 8 10-12h-7z"/></svg>
          Instant QR Code & Label Pass
        </span>
        <span class="sep"></span>
        <span class="ti">
          <svg viewBox="0 0 24 24"><path d="M12 2l8 4v6c0 5-4 8-8 10-4-2-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/></svg>
          GDPR & Level 2 Data Protected
        </span>
      </div>
    </div>
  </section>

  <!-- ===================== WHY QRETURNS (PROBLEM VS SOLUTION) ===================== -->
  <section class="sec">
    <div class="wrap">
      <div class="shead ctr rv mb-10">
        <span class="eyebrow"><span class="dot"></span> Why QReturns</span>
        <h2>Manual returns drain your time. <em>And lose the sale.</em></h2>
        <p class="lead-c">
          Handling returns through email tickets and manual refunds frustrates customers and leaks revenue. Here is how QReturns transforms returns into an automated growth engine.
        </p>
      </div>

      <div class="ps rv">
        <!-- Bad column -->
        <div class="ps-col bad">
          <span class="tag">Manual Return Process</span>
          <ul>
            <li>
              <span class="mk" set:html={crossIcon} />
              <span><b>100% lost revenue:</b> Customers default to cash refunds because exchanges and credit are difficult to request.</span>
            </li>
            <li>
              <span class="mk" set:html={crossIcon} />
              <span><b>High support workload:</b> Support reps spend hours collecting photos, verifying order dates, and sending manual label PDFs.</span>
            </li>
            <li>
              <span class="mk" set:html={crossIcon} />
              <span><b>External redirection:</b> Customers are sent to third-party domains that break your branding and trust.</span>
            </li>
            <li>
              <span class="mk" set:html={crossIcon} />
              <span><b>Manual label generation:</b> Generating shipping labels requires logging into separate carrier dashboards.</span>
            </li>
            <li>
              <span class="mk" set:html={crossIcon} />
              <span><b>Delayed inventory restocking:</b> Returned items sit uninspected without real-time tracking back into Shopify inventory.</span>
            </li>
          </ul>
        </div>

        <!-- Good column -->
        <div class="ps-col good">
          <span class="tag">QReturns Automation</span>
          <ul>
            <li>
              <span class="mk" set:html={checkIcon} />
              <span><b>Retain up to 40%+ revenue:</b> In-portal size exchanges and store credit with configurable bonus incentives (e.g. +10%) save the sale.</span>
            </li>
            <li>
              <span class="mk" set:html={checkIcon} />
              <span><b>Self-service in 2 minutes:</b> Customers look up their order, select items, upload photos, and get instant answers 24/7.</span>
            </li>
            <li>
              <span class="mk" set:html={checkIcon} />
              <span><b>Hosted on your domain:</b> Powered by Shopify App Proxy (<code>yourstore.com/apps/returns</code>) with zero redirects.</span>
            </li>
            <li>
              <span class="mk" set:html={checkIcon} />
              <span><b>Native QR & labels:</b> Instant printerless QR mobile passes and prepaid shipping labels via Shopify Reverse Deliveries.</span>
            </li>
            <li>
              <span class="mk" set:html={checkIcon} />
              <span><b>Automated rules & auto-approval:</b> Auto-approve low-risk returns, enforce 30-day windows, and apply restocking fees automatically.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== INTERACTIVE ENGINE SHOWCASE ===================== -->
  <section class="sec alt">
    <div class="wrap">
      <div class="shead ctr rv mb-10">
        <span class="eyebrow"><span class="dot"></span> Product Showcase</span>
        <h2>Experience the engine in action.</h2>
        <p class="lead-c">
          Test the customer self-service resolution flow, explore merchant auto-approval rules, and see how retained revenue is tracked in real time.
        </p>
      </div>

      <div class="rv">
        <PortalConsole />
      </div>
    </div>
  </section>

  <!-- ===================== CORE FEATURES BENTO GRID ===================== -->
  <section class="sec">
    <div class="wrap">
      <div class="shead ctr rv mb-12">
        <span class="eyebrow"><span class="dot"></span> Core Capabilities</span>
        <h2>Everything you need to master <em>returns & exchanges.</em></h2>
        <p class="lead-c">
          Built strictly on Shopify Admin APIs, Polaris design principles, and scalable reverse logistics.
        </p>
      </div>

      <div class="cards rv">
        <!-- Feature 1 -->
        <div class="card">
          <div>
            <div class="ic">
              <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <h3>Branded App Proxy Portal</h3>
            <p>
              Hosted directly on your store domain (<code>yourstore.com/apps/returns</code>). No third-party URLs, no cookie tracking issues, and 100% on-brand styling.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-line text-xs font-semibold text-green-ink flex items-center gap-1">
            <span>Seamless customer trust</span> →
          </div>
        </div>

        <!-- Feature 2 -->
        <div class="card">
          <div>
            <div class="ic">
              <svg viewBox="0 0 24 24"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <h3>Incentivized Store Credit & Bonuses</h3>
            <p>
              Add a customizable bonus (e.g. +10% extra credit) when shoppers choose store credit over a refund. A $50 return becomes $55 to spend in your shop.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-line text-xs font-semibold text-green-ink flex items-center gap-1">
            <span>Retain sales revenue</span> →
          </div>
        </div>

        <!-- Feature 3 -->
        <div class="card">
          <div>
            <div class="ic">
              <svg viewBox="0 0 24 24"><path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/></svg>
            </div>
            <h3>1-Click Variant & Catalog Exchanges</h3>
            <p>
              Allow customers to instantly swap size, color, or style with real-time Shopify inventory reservations. Settle price differences via Shopify draft orders.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-line text-xs font-semibold text-green-ink flex items-center gap-1">
            <span>Save sizing returns</span> →
          </div>
        </div>

        <!-- Feature 4 -->
        <div class="card">
          <div>
            <div class="ic">
              <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            </div>
            <h3>Mobile QR Passes & Shipping Labels</h3>
            <p>
              Shoppers without a home printer can generate digital carrier QR codes for easy mobile drop-offs. Download prepaid labels powered by Shopify Reverse Deliveries.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-line text-xs font-semibold text-green-ink flex items-center gap-1">
            <span>Printerless drop-off</span> →
          </div>
        </div>

        <!-- Feature 5 -->
        <div class="card">
          <div>
            <div class="ic">
              <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            </div>
            <h3>Rules Engine & Auto-Approval</h3>
            <p>
              Set flexible return windows, auto-approve low-risk items, configure restocking fees (% per line), deduct return shipping fees, and exempt clearance items.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-line text-xs font-semibold text-green-ink flex items-center gap-1">
            <span>Zero manual overhead</span> →
          </div>
        </div>

        <!-- Feature 6 -->
        <div class="card">
          <div>
            <div class="ic">
              <svg viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <h3>Keep-Item / Green Return Rules</h3>
            <p>
              Automatically allow customers to keep or donate low-value or damaged items when reverse shipping costs exceed product value. Protect your margins.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-line text-xs font-semibold text-green-ink flex items-center gap-1">
            <span>Save shipping fees</span> →
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== HOW IT WORKS (4-STEP FLOW) ===================== -->
  <section class="sec alt">
    <div class="wrap">
      <div class="shead ctr rv mb-12">
        <span class="eyebrow"><span class="dot"></span> Customer & Merchant Journey</span>
        <h2>How QReturns works in 4 simple steps.</h2>
        <p class="lead-c">
          A seamless flow designed to make returns effortless for buyers while keeping merchants in total control.
        </p>
      </div>

      <div class="steps rv">
        <!-- Step 1 -->
        <div class="step">
          <span class="sn">Step 01</span>
          <h3>1. Order Lookup</h3>
          <p>
            Customer enters their Order Number (e.g. <code>#1042</code>) and email address directly on your store's return page.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="step">
          <span class="sn">Step 02</span>
          <h3>2. Items & Reason</h3>
          <p>
            Customer selects eligible items, specifies return reasons from your custom taxonomy, and optionally uploads damage photos.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="step">
          <span class="sn">Step 03</span>
          <h3>3. Choose Resolution</h3>
          <p>
            Shopper chooses between Store Credit (+bonus %), instant size/variant exchange, or original payment method refund.
          </p>
        </div>

        <!-- Step 4 -->
        <div class="step">
          <span class="sn">Step 04</span>
          <h3>4. Instant Drop-Off & Sync</h3>
          <p>
            Instant QR pass or shipping label is issued. QReturns syncs return state, restocks inventory, and completes the workflow in Shopify.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== SHOPIFY DEEP INTEGRATION ===================== -->
  <section class="sec">
    <div class="wrap">
      <div class="split rv">
        <div>
          <span class="eyebrow"><span class="dot"></span> Natively Integrated</span>
          <h2>Shopify is the source of truth. <em>Never out of sync.</em></h2>
          <p class="lead">
            QReturns coordinates directly with Shopify's newest APIs (2026-04). We don't maintain a detached ledger—returns, refunds, draft orders, and store credit live directly in your Shopify Admin.
          </p>
          <ul class="checklist">
            <li>
              <span set:html={checkIcon} />
              <span><b>Shopify App Proxy:</b> Customer portal runs under your store domain with HMAC signature security and zero third-party cookies.</span>
            </li>
            <li>
              <span set:html={checkIcon} />
              <span><b>Native Return APIs:</b> Uses <code>returnProcess</code> and <code>reverseDeliveryCreateWithShipping</code> without deprecated mutations.</span>
            </li>
            <li>
              <span set:html={checkIcon} />
              <span><b>Store Credit & Gift Cards:</b> Direct integration with Shopify Store Credit Accounts with automatic Gift Card fallbacks.</span>
            </li>
            <li>
              <span set:html={checkIcon} />
              <span><b>Polaris Admin Interface:</b> Manage returns, policy rules, and analytics right inside Shopify Admin.</span>
            </li>
          </ul>
        </div>

        <div class="rounded-2xl border border-line bg-bg-2 p-6 sm:p-8 space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-line">
            <span class="font-mono text-xs font-bold text-ink">Shopify Ecosystem Architecture</span>
            <span class="badge badge-green text-[0.65rem]">Direct GraphQL</span>
          </div>

          <div class="space-y-3">
            <div class="p-3.5 rounded-xl bg-white border border-line flex items-center justify-between text-xs">
              <div class="flex items-center gap-2.5">
                <span class="w-2.5 h-2.5 rounded-full bg-green"></span>
                <span class="font-bold text-ink">Your Shopify Storefront</span>
              </div>
              <span class="font-mono text-muted">your-store.com/apps/returns</span>
            </div>

            <div class="flex justify-center text-muted">
              <svg class="w-4 h-4 animate-bounce" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
            </div>

            <div class="p-3.5 rounded-xl bg-white border-2 border-green flex items-center justify-between text-xs shadow-xs">
              <div class="flex items-center gap-2.5">
                <span class="w-2.5 h-2.5 rounded-full bg-green"></span>
                <span class="font-bold text-ink">QReturns Core Engine</span>
              </div>
              <span class="badge badge-green text-[0.65rem]">Rules & Retention</span>
            </div>

            <div class="flex justify-center text-muted">
              <svg class="w-4 h-4 animate-bounce" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
            </div>

            <div class="p-3.5 rounded-xl bg-white border border-line flex items-center justify-between text-xs">
              <div class="flex items-center gap-2.5">
                <span class="w-2.5 h-2.5 rounded-full bg-green"></span>
                <span class="font-bold text-ink">Shopify Admin (Orders, Inventory & Credit)</span>
              </div>
              <span class="font-mono text-muted">Source of Truth</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== PRICING TEASER ===================== -->
  <section class="sec alt">
    <div class="wrap">
      <div class="shead ctr rv mb-12">
        <span class="eyebrow"><span class="dot"></span> Transparent Pricing</span>
        <h2>Start free. Upgrade as your returns scale.</h2>
        <p class="lead-c">
          Every new installation receives <strong>{REVERSE_TRIAL_DAYS} days of full Growth access</strong>. Afterwards, stay on the Free plan forever or pick the tier that matches your monthly return volume.
        </p>
      </div>

      <div class="plans rv">
        {PLANS.map((p) => (
          <div class={`plan ${p.feat ? 'feat' : ''}`}>
            {p.badge && <span class="badge">{p.badge}</span>}
            <span class="ptag">{p.name}</span>
            <div class="price">
              <b>{p.price}</b>
              <span>{p.period}</span>
            </div>
            <span class="quota-tag">{p.quota}</span>
            <p class="pdesc">{p.desc}</p>
            <ul>
              {p.features.slice(0, TEASER_BULLETS).map((f) => (
                <li>
                  <span set:html={checkIcon} />
                  <span>{f}</span>
                </li>
              ))}
            </ul>
            <a
              href={APP_STORE_URL}
              class={`btn ${p.feat ? 'btn-accent' : 'btn-line'} btn-sm w-full mt-auto`}
            >
              {p.price === '$0' ? 'Install free' : 'Start 14-day trial'}
            </a>
          </div>
        ))}
      </div>

      <p class="kicker text-center mt-8">
        Soft return limits: customers are never blocked at the portal · Billed via Shopify Billing API · Cancel anytime
      </p>
    </div>
  </section>

  <!-- ===================== FAQ SECTION ===================== -->
  <section class="sec">
    <div class="wrap">
      <div class="shead ctr rv mb-12">
        <span class="eyebrow"><span class="dot"></span> FAQ</span>
        <h2>Frequently asked questions</h2>
        <p class="lead-c">
          Everything you need to know about setting up QReturns on your Shopify store.
        </p>
      </div>

      <div class="faq rv">
        <details>
          <summary>
            <span>How does QReturns run on my store domain without redirects?</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <p>
            QReturns uses the native <strong>Shopify App Proxy</strong>. When shoppers visit <code>yourstore.com/apps/returns</code>, Shopify securely proxies the request to QReturns with cryptographic HMAC signature verification. Your customers stay entirely on your brand's domain.
          </p>
        </details>

        <details>
          <summary>
            <span>How does the Store Credit Bonus incentive work?</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <p>
            You can specify an optional bonus percentage (for example, +10%) in your merchant settings. If a customer returns a $50 item and chooses Store Credit, QReturns automatically issues a $55 store gift card or Shopify store credit balance. It is the single most effective way to retain revenue that would otherwise be lost to cash refunds.
          </p>
        </details>

        <details>
          <summary>
            <span>What happens if my store exceeds the monthly return quota?</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <p>
            Our quotas are designed as gentle thresholds for merchants, not walls for your customers. If you exceed your plan's return quota, your customer portal continues running normally with zero interruption. You will see a friendly upgrade notification in your Shopify Admin dashboard.
          </p>
        </details>

        <details>
          <summary>
            <span>Does QReturns support printerless mobile drop-offs?</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <p>
            Yes! Customers without home printers can generate a digital QR code mobile pass on their smartphone to present at authorized carrier drop-off locations (e.g. USPS or partner locations). Traditional downloadable PDF prepaid shipping labels are also supported.
          </p>
        </details>

        <details>
          <summary>
            <span>Do I need to edit my Shopify theme code?</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <p>
            No theme code modification is required. Once installed, your return portal is immediately reachable at <code>/apps/returns</code>. You can simply add a link to your navigation menu, website footer, or customer order confirmation emails.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- ===================== FINAL CONVERSION CTA ===================== -->
  <section class="sec" style="padding-top: 0;">
    <div class="wrap">
      <div class="cta-box rv">
        <span class="eyebrow" style="color: #2bd996; justify-content: center;">
          <span class="dot" style="background: #2bd996;"></span> Get Started in 60 Seconds
        </span>
        <h2 class="font-display font-bold text-3xl sm:text-4xl md:text-5xl mt-4 mb-4 tracking-tightest">
          Ready to turn returns into your growth engine?
        </h2>
        <p class="text-gray-300 text-base md:text-lg max-w-xl mx-auto mb-8 leading-relaxed">
          Install QReturns today with 14 days of full Growth access. Keep more revenue in your store and give customers a delightful self-service experience.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a href={APP_STORE_URL} class="btn btn-green btn-lg">
            Install on Shopify <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a href={DEMO_URL} class="btn btn-line btn-lg" style="background: rgba(255,255,255,0.1); color: #fff; border-color: rgba(255,255,255,0.2);">
            View live demo
          </a>
        </div>
        <p class="font-mono text-xs uppercase text-gray-400 mt-6">
          Free plan forever · No credit card required on install · 1-click Shopify setup
        </p>
      </div>
    </div>
  </section>
</Base>
