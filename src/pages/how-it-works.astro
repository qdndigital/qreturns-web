---
import Base from '../layouts/Base.astro';
import { APP_STORE_URL, DEMO_URL, SITE_NAME } from '../consts';
import { REVERSE_TRIAL_DAYS } from '../plans';

const title = `How Qreturns Works — The Returns Lifecycle`;
const description = 'See how Qreturns works: customer self-service sign-in, your return rules, prepaid labels through Shippo, and approval, inspection and refund inside Shopify.';

const checkIcon = '<svg viewBox="0 0 24 24"><path d="M5 13l4 4L19 7"/></svg>';
---

<Base title={title} description={description}>
  <section class="phero">
    <div class="wrap">
      <div class="crumb"><a href="/">~</a> / how it works</div>
      <h1>How the Qreturns engine <em>works</em>.</h1>
      <p>
        No black box. Qreturns provides a clean, four-stage returns lifecycle that is simple for shoppers, keeps you in control with your own rules, and syncs directly with Shopify APIs.
      </p>
    </div>
  </section>

  <!-- ===================== 1. THE 4 STAGES ===================== -->
  <section class="sec">
    <div class="wrap">
      <div class="shead rv mb-10">
        <span class="eyebrow"><span class="dot"></span> Stage by Stage</span>
        <h2>The end-to-end customer return journey.</h2>
        <p class="lead-c" style="margin-left: 0; text-align: left;">
          Customers can start a return in a few minutes, and you see it in Shopify Admin straight away.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 rv">
        <!-- Stage 1 -->
        <div class="p-6 md:p-8 rounded-2xl border border-line bg-white shadow-xs space-y-3">
          <span class="font-mono text-xs font-bold text-brand-ink bg-brand-soft px-2.5 py-1 rounded border border-brand-line">
            Stage 01
          </span>
          <h3 class="font-display font-bold text-lg text-ink">Sign In & Pick an Order</h3>
          <p class="text-sm text-ink-2 leading-relaxed">
            Customers visit <code>yourstore.com/apps/returns</code> on your domain and sign in with their store account. They see only their own orders, with a Return button on each one that can be returned.
          </p>
          <ul class="checklist">
            <li><span set:html={checkIcon} /><span>Only the owner of an order can return it</span></li>
            <li><span set:html={checkIcon} /><span>Shopify App Proxy with HMAC signature security</span></li>
            <li><span set:html={checkIcon} /><span>Return window checked against your rules</span></li>
          </ul>
        </div>

        <!-- Stage 2 -->
        <div class="p-6 md:p-8 rounded-2xl border border-line bg-white shadow-xs space-y-3">
          <span class="font-mono text-xs font-bold text-brand-ink bg-brand-soft px-2.5 py-1 rounded border border-brand-line">
            Stage 02
          </span>
          <h3 class="font-display font-bold text-lg text-ink">Item Selection & Reason Taxonomy</h3>
          <p class="text-sm text-ink-2 leading-relaxed">
            The customer sees all items from their order with quantities and variant details. They select eligible items and provide structured return reasons.
          </p>
          <ul class="checklist">
            <li><span set:html={checkIcon} /><span>Item picker with final-sale and non-returnable indicators</span></li>
            <li><span set:html={checkIcon} /><span>Return reasons taken from Shopify's own list</span></li>
            <li><span set:html={checkIcon} /><span>Optional photo uploads, stored in Shopify Files</span></li>
          </ul>
        </div>

        <!-- Stage 3 -->
        <div class="p-6 md:p-8 rounded-2xl border border-line bg-white shadow-xs space-y-3">
          <span class="font-mono text-xs font-bold text-brand-ink bg-brand-soft px-2.5 py-1 rounded border border-brand-line">
            Stage 03
          </span>
          <h3 class="font-display font-bold text-lg text-ink">Return Method & Shipping</h3>
          <p class="text-sm text-ink-2 leading-relaxed">
            The customer sees how the item gets back to you and what return shipping costs, based on your rules and products.
          </p>
          <ul class="checklist">
            <li><span set:html={checkIcon} /><span>Free return shipping on orders with the Protect Product</span></li>
            <li><span set:html={checkIcon} /><span>Free Return products ship free; others pay the label price at checkout</span></li>
            <li><span set:html={checkIcon} /><span>Refund to the original payment method</span></li>
            <li><span set:html={checkIcon} /><span>Store credit and exchanges are coming later</span></li>
          </ul>
        </div>

        <!-- Stage 4 -->
        <div class="p-6 md:p-8 rounded-2xl border border-line bg-white shadow-xs space-y-3">
          <span class="font-mono text-xs font-bold text-brand-ink bg-brand-soft px-2.5 py-1 rounded border border-brand-line">
            Stage 04
          </span>
          <h3 class="font-display font-bold text-lg text-ink">Approve, Label & Refund</h3>
          <p class="text-sm text-ink-2 leading-relaxed">
            Returns your rules accept open straight away; the others wait for you. Approved returns get a prepaid label, and you refund after inspection.
          </p>
          <ul class="checklist">
            <li><span set:html={checkIcon} /><span>Prepaid label bought on your own Shippo account</span></li>
            <li><span set:html={checkIcon} /><span>Inspect the parcel, then Complete & refund through Shopify</span></li>
            <li><span set:html={checkIcon} /><span>Status page and timeline for you and the customer</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== 2. RULES ENGINE DEEP DIVE ===================== -->
  <section class="sec alt">
    <div class="wrap">
      <div class="split rv">
        <div>
          <span class="eyebrow"><span class="dot"></span> Merchant Governance</span>
          <h2>Automate rules with total precision.</h2>
          <p class="lead">
            Create granular policies that balance customer convenience with profitability. The Qreturns rules engine evaluates criteria hierarchically.
          </p>
          <ul class="checklist">
            <li>
              <span set:html={checkIcon} />
              <span><b>Flexible Return Windows:</b> Count the window from the order, fulfilment or delivery date.</span>
            </li>
            <li>
              <span set:html={checkIcon} />
              <span><b>Asymmetric Fee Deductions:</b> Apply percentage restocking fees per line item, or fixed return shipping fees per return.</span>
            </li>
            <li>
              <span set:html={checkIcon} />
              <span><b>Product Policy:</b> Mark products as Free Return or Non-Returnable, and flag final-sale items.</span>
            </li>
            <li>
              <span set:html={checkIcon} />
              <span><b>Smart Auto-Approval:</b> Instantly approve returns that meet your policy thresholds, freeing up merchant support time.</span>
            </li>
          </ul>
        </div>

        <div class="p-6 md:p-8 rounded-2xl border border-line bg-white shadow-xs space-y-4">
          <div class="font-mono text-xs uppercase font-bold text-ink pb-3 border-b border-line">
            Rule Evaluation Matrix
          </div>
          <div class="space-y-3 text-xs">
            <div class="p-3 rounded-xl bg-bg-2 border border-line">
              <div class="font-bold text-ink mb-1">1. Eligibility Check</div>
              <div class="text-muted">Is the order inside your return window? Are items free of "final-sale" tags?</div>
            </div>
            <div class="p-3 rounded-xl bg-bg-2 border border-line">
              <div class="font-bold text-ink mb-1">2. Product Check</div>
              <div class="text-muted">Is this product on your Free Return or Non-Returnable list?</div>
            </div>
            <div class="p-3 rounded-xl bg-bg-2 border border-line">
              <div class="font-bold text-ink mb-1">3. Fee Calculation</div>
              <div class="text-muted">Calculate restocking fee (% per line) + return shipping fee (fixed amount).</div>
            </div>
            <div class="p-3 rounded-xl bg-brand-soft/40 border border-brand-line">
              <div class="font-bold text-brand-ink mb-1">4. Decision: Auto-Approve vs. Manual Review</div>
              <div class="text-ink-2">If criteria pass: Buy the Shippo label. If manual: Flag in Admin.</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== 3. STATE MACHINE ===================== -->
  <section class="sec">
    <div class="wrap">
      <div class="shead ctr rv mb-10">
        <span class="eyebrow"><span class="dot"></span> Lifecycle Transparency</span>
        <h2>Rock-solid state machine.</h2>
        <p class="lead-c">
          Every return follows a strictly verified transition path. Shopify remains the authoritative ledger for return objects and inventory adjustments.
        </p>
      </div>

      <div class="p-6 md:p-8 rounded-2xl border border-line bg-white shadow-xs rv max-w-4xl mx-auto">
        <div class="flex flex-wrap items-center justify-between gap-3 text-center text-xs font-mono font-bold">
          <span class="p-2.5 rounded-lg bg-bg-2 border border-line">REQUESTED</span>
          <span>→</span>
          <span class="p-2.5 rounded-lg bg-brand-soft text-brand-ink border border-brand-line">APPROVED</span>
          <span>→</span>
          <span class="p-2.5 rounded-lg bg-bg-2 border border-line">LABEL_ISSUED</span>
          <span>→</span>
          <span class="p-2.5 rounded-lg bg-bg-2 border border-line">IN_TRANSIT</span>
          <span>→</span>
          <span class="p-2.5 rounded-lg bg-bg-2 border border-line">DELIVERED</span>
          <span>→</span>
          <span class="p-2.5 rounded-lg bg-brand-soft text-brand-ink border border-brand-line">COMPLETED</span>
        </div>
        <p class="text-xs text-muted text-center mt-6">
          Forward-only tracking ranks prevent out-of-order webhook delivery from regressing return states.
        </p>
      </div>
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section class="sec" style="padding-top:0">
    <div class="wrap">
      <div class="cta-box rv">
        <h2 class="font-display font-bold text-3xl md:text-4xl mb-4">
          Experience the complete workflow today.
        </h2>
        <p class="text-gray-300 text-base max-w-xl mx-auto mb-8">
          Try the interactive customer return portal demo or install Qreturns on your Shopify store with {REVERSE_TRIAL_DAYS} days full access.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-3">
          <a href={APP_STORE_URL} class="btn btn-brand btn-lg">Install on Shopify</a>
          <a href={DEMO_URL} class="btn btn-line btn-lg" style="background: rgba(255,255,255,0.1); color: #fff; border-color: rgba(255,255,255,0.2);">
            Try interactive demo
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
